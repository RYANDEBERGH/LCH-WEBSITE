  "reasons": {
    "heading": "Why owners hire us",
    "items": [
      {
        "title": "We think like owners",
        "body": "We invest in and develop our own projects, so we know what it takes for one to be financed, built and operated. Every recommendation is tested against cost, leasing and buildability."
      },
      {
        "title": "Development and construction in one team",
        "body": "LCH and Elevate work together from the start, so construction cost, trade input and sequencing shape the design before decisions become expensive to change."
      },
      {
        "title": "Workstreams run in parallel",
        "body": "Where possible, approvals, site plan, permits and tendering advance together instead of one after another, shortening the path to construction."
      },
      {
        "title": "Principals stay involved",
        "body": "Our founders and senior team stay hands-on in each mandate, not just reviewing it from a distance."
      },
      {
        "title": "Institutional-quality reporting",
        "body": "Budgets, cost to complete, schedules, risk registers and decision logs give owners and lenders a clear view of the project at every stage."
      },
      {
        "title": "Experience with difficult projects",
        "body": "Heritage conversions, constrained infill sites, condominium projects repositioned as rental, and stalled projects taken over for receivers."
      }
    ]
  },
