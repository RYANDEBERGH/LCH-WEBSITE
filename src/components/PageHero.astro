---
import Img from './Img.astro';
interface Props { eyebrow?: string; heading: string; lede?: string; image?: string }
const { eyebrow, heading, lede, image } = Astro.props;
---

{image ? (
  <section class="phero phero--image on-image">
    <Img src={image} alt="" loading="eager" fetchpriority="high" class="phero__bg" />
    <div class="container phero__content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
  </section>
) : (
  <section class="phero">
    <div class="container phero__content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
  </section>
)}

<style>
  .phero { padding-block: clamp(56px, 9vw, 128px) clamp(40px, 6vw, 80px); }
  .phero h1 { max-width: 24ch; font-size: clamp(30px, 3.2vw, 46px); }
  .phero .lede { margin-top: 24px; }
  .phero--image { position: relative; min-height: min(calc(78svh - var(--announce-h)), 720px); display: flex; align-items: flex-end; color: var(--paper); padding-top: calc(var(--header-h) + 48px); isolation: isolate; }
  .phero--image::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(10, 10, 9, 0.6) 0%, rgba(10, 10, 9, 0) 65%), linear-gradient(180deg, rgba(10, 10, 9, 0.45) 0%, rgba(10, 10, 9, 0.1) 35%, rgba(10, 10, 9, 0.75) 100%); }
  :global(.phero__bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .phero--image .lede { color: rgba(246, 244, 239, 0.85); }
  .phero--image .phero__content { position: relative; }
</style>
