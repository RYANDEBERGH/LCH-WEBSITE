---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';
import { formatDate } from '../lib/site';
interface Props { post: CollectionEntry<'news'> }
const { post } = Astro.props;
const d = post.data;
---

<a class="ncard reveal" href={`/news/${post.id}/`} data-topic={d.topic}>
  <div class="ncard__media">
    {d.image ? <Img src={d.image} alt="" sizes="(max-width: 760px) 100vw, 33vw" /> : <div class="ncard__ph" />}
  </div>
  <p class="ncard__meta"><span>{d.topic}</span><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
  <h3 class="ncard__title">{d.title}</h3>
</a>

<style>
  .ncard { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .ncard__media { aspect-ratio: 3 / 2; overflow: hidden; border-radius: var(--radius); background: var(--paper-2); margin-bottom: 18px; }
  .ncard__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .ncard:hover .ncard__media :global(img) { transform: scale(1.04); }
  .ncard__ph { width: 100%; height: 100%; background: linear-gradient(135deg, var(--paper-2), #dcd6ca); }
  .ncard__meta { display: flex; gap: 14px; font-size: 13px; color: var(--muted); margin-bottom: 8px; }
  .ncard__meta span { font-weight: 600; color: var(--accent); letter-spacing: 0.04em; }
  .ncard__title { font-size: 20px; line-height: 1.3; transition: color 0.25s; }
  .ncard:hover .ncard__title { color: var(--accent); }
</style>
