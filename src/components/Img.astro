---
// Responsive image. Pass any path from /uploads/ and it automatically serves
// right-sized WebP files generated by scripts/optimize-images.mjs.
import sharp from 'sharp';
import path from 'node:path';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { src, alt, sizes = '100vw', class: cls, loading = 'lazy', fetchpriority } = Astro.props;
const WIDTHS = [480, 960, 1600, 2400];

let width: number | undefined;
let height: number | undefined;
let srcset: string | undefined;
if (src?.startsWith('/uploads/')) {
  try {
    const meta = await sharp(path.join(process.cwd(), 'public', src)).metadata();
    width = meta.width;
    height = meta.height;
    const base = src.replace(/^\/uploads\//, '/_img/').replace(/\.[^.]+$/, '');
    // keep every size up to the original, plus the first size above it (which holds the original resolution)
    srcset = WIDTHS.filter((w, i) => !width || w <= width || i === 0 || WIDTHS[i - 1] < width)
      .map((w) => `${base}-${w}.webp ${Math.min(w, width ?? w)}w`)
      .join(', ');
  } catch {
    /* image missing — fall back to plain <img> */
  }
}
---

<img
  src={src}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={cls}
/>
