---
// Publications that have covered LCH, built from News & Media articles marked "In the Press".
import { getNews, formatDate } from '../lib/site';
interface Props { eyebrow?: string; heading?: string; count?: number }
const { eyebrow = 'In the press', heading = 'Latest coverage', count = 4 } = Astro.props;
const press = (await getNews()).filter((n) => n.data.topic === 'In the Press' && n.data.publisher).slice(0, count);
---

{press.length > 0 && (
  <section class="press section--tight" aria-label="Latest press coverage">
    <div class="container">
      <div class="press__head">
        <p class="eyebrow">{eyebrow}</p>
        <a class="link-arrow" href="/news/">All news & media →</a>
      </div>
      <h2 class="sr-only">{heading}</h2>
      <ul class="press__list">
        {press.map((n) => (
          <li>
            <a href={`/news/${n.id}/`} class="press__item">
              <span class="press__name">{n.data.publisher}</span>
              <time class="press__meta" datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>
              <span class="press__headline">{n.data.title.replace(/^[^:–]+[:–]\s*/, '')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .press { border-block: 1px solid var(--line); }
  .press__head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .press__head .eyebrow { margin: 0; }
  .press__head .link-arrow { font-size: 14px; }
  .press__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .press__list li { border-left: 1px solid var(--line); }
  .press__list li:first-child { border-left: 0; }
  .press__item { display: grid; gap: 6px; padding: 8px 24px 8px 24px; text-decoration: none; height: 100%; }
  .press__list li:first-child .press__item { padding-left: 0; }
  .press__name { font-family: var(--font-display); font-size: 26px; line-height: 1.1; transition: color 0.2s; }
  .press__item:hover .press__name { color: var(--accent); }
  .press__meta { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .press__headline { font-size: 14px; color: var(--ink-2); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 700px) {
    .press__list { grid-template-columns: 1fr 1fr; }
    .press__list li { border-left: 0; border-top: 1px solid var(--line); }
    .press__item, .press__list li:first-child .press__item { padding: 16px 12px 16px 0; }
  }
</style>
