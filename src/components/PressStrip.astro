---
// Publications that have covered LCH, built from News & Media articles marked "In the Press".
import { getNews, formatDate } from '../lib/site';
interface Props { eyebrow?: string; heading?: string }
const { eyebrow = 'In the press', heading = 'Covered by' } = Astro.props;
const press = (await getNews()).filter((n) => n.data.topic === 'In the Press' && n.data.publisher);
const byPub = new Map<string, typeof press>();
for (const n of press) byPub.set(n.data.publisher!, [...(byPub.get(n.data.publisher!) ?? []), n]);
const pubs = [...byPub.entries()].sort((a, b) => b[1].length - a[1].length || b[1][0].data.date.valueOf() - a[1][0].data.date.valueOf());
---

{pubs.length > 0 && (
  <section class="press section--tight" aria-label="Press coverage">
    <div class="container">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="sr-only">{heading}</h2>
      <ul class="press__list">
        {pubs.map(([pub, items]) => (
          <li>
            <a href={`/news/${items[0].id}/`} class="press__item">
              <span class="press__name">{pub}</span>
              <span class="press__meta">{`${items.length} ${items.length === 1 ? 'article' : 'articles'} · latest ${formatDate(items[0].data.date)}`}</span>
              <span class="press__headline">{items[0].data.title.replace(/^[^:–]+[:–]\s*/, '')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .press { border-block: 1px solid var(--line); }
  .press .eyebrow { margin-bottom: 18px; }
  .press__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0; }
  .press__list li { border-left: 1px solid var(--line); }
  .press__list li:first-child { border-left: 0; }
  .press__item { display: grid; gap: 6px; padding: 8px 24px 8px 24px; text-decoration: none; height: 100%; }
  .press__list li:first-child .press__item { padding-left: 0; }
  .press__name { font-family: var(--font-display); font-size: 30px; line-height: 1.1; transition: color 0.2s; }
  .press__item:hover .press__name { color: var(--accent); }
  .press__meta { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .press__headline { font-size: 14px; color: var(--ink-2); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 700px) {
    .press__list { grid-template-columns: 1fr 1fr; }
    .press__list li { border-left: 0; border-top: 1px solid var(--line); }
    .press__item, .press__list li:first-child .press__item { padding: 16px 12px 16px 0; }
  }
</style>
