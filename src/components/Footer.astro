---
import { settings, telHref } from '../lib/site';
const n = settings.newsletter;
// If a Mailchimp embedded-form URL is set, sign-ups go straight to your Mailchimp audience;
// otherwise they're collected by Netlify Forms.
const mc = n?.mailchimpUrl?.trim();
const year = new Date().getFullYear();
const socials = [
  { key: 'instagram', label: 'Instagram', path: 'M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1.1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1a6.7 6.7 0 100 13.4 6.7 6.7 0 000-13.4zm0 11a4.3 4.3 0 110-8.6 4.3 4.3 0 010 8.6zm6.9-11.3a1.6 1.6 0 11-3.2 0 1.6 1.6 0 013.2 0z' },
  { key: 'facebook', label: 'Facebook', path: 'M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0022 12z' },
  { key: 'linkedin', label: 'LinkedIn', path: 'M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6h.1c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 110-4.2 2.1 2.1 0 010 4.2zM7.1 20.5H3.6V9h3.5v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z' },
] as const;
---

<footer class="footer section--dark">
  {n?.enabled && (
    <div class="container footer__newsletter">
      <div>
        <p class="eyebrow">Newsletter</p>
        <h2>{n.heading}</h2>
        <p class="lede">{n.text}</p>
      </div>
      {mc ? (
      <form method="POST" action={mc} target="_blank" class="newsletter-form">
        <div class="newsletter-form__row">
          <div class="field"><label for="nl-first">First name</label><input id="nl-first" name="FNAME" autocomplete="given-name" required /></div>
          <div class="field"><label for="nl-last">Last name</label><input id="nl-last" name="LNAME" autocomplete="family-name" required /></div>
        </div>
        <div class="field"><label for="nl-email">Email</label><input id="nl-email" type="email" name="EMAIL" autocomplete="email" required /></div>
        <label class="check"><input type="checkbox" name="consent" value="yes" required /> <span>{n.consent}</span></label>
        <button class="btn btn--light" type="submit">Subscribe <span class="arrow" aria-hidden="true">→</span></button>
      </form>
      ) : (
      <form name="newsletter" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="company" class="newsletter-form">
        <input type="hidden" name="form-name" value="newsletter" />
        <p class="hidden-field"><label>Leave this field empty: <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <div class="newsletter-form__row">
          <div class="field"><label for="nl-first">First name</label><input id="nl-first" name="first_name" autocomplete="given-name" required /></div>
          <div class="field"><label for="nl-last">Last name</label><input id="nl-last" name="last_name" autocomplete="family-name" required /></div>
        </div>
        <div class="field"><label for="nl-email">Email</label><input id="nl-email" type="email" name="email" autocomplete="email" required /></div>
        <label class="check"><input type="checkbox" name="consent" value="yes" required /> <span>{n.consent}</span></label>
        <button class="btn btn--light" type="submit">Subscribe <span class="arrow" aria-hidden="true">→</span></button>
      </form>
      )}
    </div>
  )}

  <div class="container footer__main">
    <div class="footer__brand">
      <img src={settings.logoLight} alt={settings.siteName} width="140" height="63" loading="lazy" />
      <a class="footer__elevate" href={settings.elevate.url} target="_blank" rel="noopener" aria-label="Elevate Construction Management website (opens in a new tab)">
        <img src={settings.elevate.logoLight} alt="Elevate Construction Management" width="120" height="59" loading="lazy" />
      </a>
      <address>
        <a href={settings.mapsUrl} target="_blank" rel="noopener">{settings.address}</a>
      </address>
    </div>
    <div class="footer__col">
      <p class="footer__label">Contact</p>
      <a href={`mailto:${settings.email}`}>{settings.email}</a>
      <a href={telHref(settings.phone)}>O: {settings.phone}</a>
    </div>
    <div class="footer__col">
      <p class="footer__label">Explore</p>
      <a href="/about/">About</a>
      <a href="/projects/">Projects</a>
      <a href="/partnerships/">Partnerships</a>
      <a href="/news/">News & Media</a>
      <a href="/contact/">Contact</a>
    </div>
    <div class="footer__col">
      <p class="footer__label">Follow</p>
      <div class="footer__social">
        {socials.map((s) => settings.social[s.key] && (
          <a href={settings.social[s.key]} target="_blank" rel="noopener" aria-label={s.label}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d={s.path} /></svg>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="container footer__legal">
    <span>© {year} {settings.siteName}. All rights reserved.</span>
    <span class="footer__legal-links"><a href="/privacy-policy/">Privacy &amp; Terms</a></span>
  </div>
</footer>

<style>
  .footer { padding-top: clamp(48px, 6vw, 80px); }
  .footer__newsletter { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); padding-bottom: clamp(40px, 5vw, 64px); border-bottom: 1px solid rgba(246, 244, 239, 0.14); }
  .footer__newsletter h2 { margin-bottom: 16px; }
  .newsletter-form { display: grid; gap: 18px; align-content: start; }
  .newsletter-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .newsletter-form .field input { background: rgba(255, 255, 255, 0.06); border-color: rgba(246, 244, 239, 0.2); color: var(--paper); }
  .newsletter-form .check { color: rgba(246, 244, 239, 0.65); }
  .newsletter-form .btn { justify-self: start; }

  .footer__main { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; padding-block: 56px; }
  .footer__brand img { height: 48px; width: auto; margin-bottom: 20px; }
  .footer__elevate { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; color: rgba(246, 244, 239, 0.6); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; }
  .footer__elevate img { height: 48px; width: auto; opacity: 0.9; transition: opacity 0.2s; }
  .footer__elevate:hover img { opacity: 1; }
  .footer__brand address { font-style: normal; color: rgba(246, 244, 239, 0.7); max-width: 26ch; }
  .footer a { text-decoration: none; }
  .footer a:hover { color: var(--accent); }
  .footer__col { display: grid; gap: 8px; align-content: start; color: rgba(246, 244, 239, 0.85); }
  .footer__label { font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(246, 244, 239, 0.5); margin: 0 0 6px; }
  .footer__social { display: flex; gap: 16px; }
  .footer__legal { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; padding-block: 24px 32px; border-top: 1px solid rgba(246, 244, 239, 0.14); font-size: 14px; color: rgba(246, 244, 239, 0.55); }
  .footer__legal-links { display: flex; gap: 24px; }

  @media (max-width: 860px) {
    .footer__newsletter { grid-template-columns: 1fr; }
    .footer__main { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .newsletter-form__row { grid-template-columns: 1fr; }
  }
</style>
