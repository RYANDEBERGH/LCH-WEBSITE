---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';
import { stageTone, brandInk, isClientWork } from '../lib/site';
interface Props { project: CollectionEntry<'projects'>; sizes?: string }
const { project, sizes = '(max-width: 760px) 100vw, 33vw' } = Astro.props;
const p = project.data;
const client = isClientWork(project);
---

<a class="pcard reveal" href={`/projects/${project.id}/`} data-stage={p.stage} style={`--accent: ${brandInk(project)}`}>
  <div class:list={["pcard__media", { "pcard__media--text": !p.heroImage }]}>
    {p.heroImage ? <Img src={p.heroImage} alt={`${p.title}, ${p.neighbourhood}`} sizes={sizes} /> : (
      <div class="pcard__placeholder" aria-hidden="true">
        <span class="pcard__ph-label">{client ? 'Selected client work' : p.type}</span>
        <span class="pcard__ph-title">{p.title}</span>
        <span class="pcard__ph-loc">{p.neighbourhood}</span>
      </div>
    )}
    <span class="pcard__pills">
      {client && <span class="pill pill--client">Selected client work</span>}
      {p.stage && <span class="pill" data-tone={stageTone(p.stage)}>{p.stage}</span>}
      {p.leasing?.status && <span class="pill pill--leasing">{p.leasing.status}</span>}
    </span>
  </div>
  <div class="pcard__body">
    <p class="pcard__meta">{p.neighbourhood}</p>
    <h3 class="pcard__title display">{p.title}</h3>
    <p class="pcard__summary">{p.summary}</p>
    <p class="pcard__facts">
      {client && p.roleLabel ? <span>{p.roleLabel}</span> : <span>{p.type}</span>}
      {p.units && <span>{p.units.toLocaleString()} homes</span>}
      {p.storeys && <span>{p.storeys} storeys</span>}
    </p>
  </div>
</a>

<style>
  .pcard { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .pcard__media { position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; background: var(--paper-2); }
  .pcard__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease); }
  .pcard:hover .pcard__media :global(img) { transform: scale(1.04); }
  .pcard__media--text { background: var(--ink); }
  .pcard__placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; padding: 20px; color: var(--paper); background: linear-gradient(160deg, #2b3a44, #161614); }
  .pcard__ph-label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(246, 244, 239, 0.6); }
  .pcard__ph-title { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .pcard__ph-loc { font-size: 14px; color: rgba(246, 244, 239, 0.75); }
  .pcard__pills { position: absolute; top: 16px; left: 16px; right: 16px; display: flex; flex-wrap: wrap; gap: 6px; }
  .pcard__body { padding-top: 20px; }
  .pcard__meta { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
  .pcard__title { font-size: clamp(24px, 2.2vw, 30px); line-height: 1.05; margin-bottom: 10px; transition: color 0.25s; }
  .pcard:hover .pcard__title { color: var(--accent); }
  .pcard__summary { color: var(--muted); margin-bottom: 12px; }
  .pcard__facts { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; color: var(--ink-2); margin: 0; }
  .pcard__facts span + span::before { content: '·'; margin-right: 16px; color: var(--muted); }
</style>
