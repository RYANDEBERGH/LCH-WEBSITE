---
// "Where we build" map.
// Base map: src/data/map-geo.json, built from OpenFreeMap/OpenStreetMap tiles by scripts/build-map-tiles.mjs.
// Parks, landmarks, neighbourhood labels and which road names to show: src/data/map.json (editable in /admin).
// Project pins: each project's lat/lng (editable in /admin).
import Img from './Img.astro';
import geo from '../data/map-geo.json';
import { mapData, getProjects, isClientWork, latestMilestone, formatMilestoneDate, brandInk } from '../lib/site';

interface Props { heading?: string; eyebrow?: string; body?: string; id?: string }
const { heading, eyebrow, body, id = 'map' } = Astro.props;

// Web Mercator, same projection the base map was built with
const { z, x0, y0, s, w: W, h: H } = geo.proj;
const X = (lng: number) => +((((lng + 180) / 360) * 2 ** z - x0) * s).toFixed(1);
const Y = (lat: number) => {
  const r = (lat * Math.PI) / 180;
  return +((((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2) * 2 ** z - y0) * s).toFixed(1);
};
const kmPx = Y(43.72) - Y(43.72 + 1 / 111.2);

// Transit from the map data: Line 2 drawn through its stations (it runs under Danforth Avenue), GO stations marked
const uniq = <T extends { name: string }>(a: T[]) => [...new Map(a.map((x) => [x.name, x])).values()];
const LINE2 = ['Castle Frank', 'Broadview', 'Chester', 'Pape', 'Donlands', 'Greenwood', 'Coxwell', 'Woodbine', 'Main Street', 'Victoria Park', 'Warden', 'Kennedy'];
const subway = uniq(geo.stations.filter((st) => st.subclass === 'subway' && LINE2.includes(st.name))).sort((a, b) => a.x - b.x);
const GO = ['Danforth', 'Scarborough', 'Eglinton', 'Guildwood', 'Rouge Hill'];
const goStations = uniq(geo.stations.filter((st) => st.subclass === 'station' && GO.includes(st.name)));
// Line badges: Line 2 at Main Street station, Line 5 at Golden Mile stop, Line 3 near Gerrard & Carlaw
const at = (name: string, sub?: string) => geo.stations.find((st) => st.name === name && (!sub || st.subclass === sub));
const lineBadges = [
  { n: '2', name: 'Line 2 Bloor-Danforth', cls: 'l2', p: at('Main Street', 'subway'), dx: 0, dy: -26 },
  { n: '5', name: 'Line 5 Eglinton', cls: 'l5', p: at('Golden Mile'), dx: 0, dy: -24 },
  { n: '3', name: 'Line 3 Ontario Line (future)', cls: 'l3', p: { x: geo.ontarioLineLabel[0], y: geo.ontarioLineLabel[1] }, dx: 16, dy: 0 },
].filter((b) => b.p);

const wantedLabels = new Set(mapData.roadLabels ?? []);
const roadLabels = geo.roadLabels.filter((l) => wantedLabels.has(l.name)).map((l) => ({ ...l, name: l.name.replace(' Express', '') }));

// LCH's own developments only (client work is shown on the Projects page and About Us)
const everything = (await getProjects()).filter((p) => !isClientWork(p));
const all = everything.filter((p) => p.data.lat != null && p.data.lng != null);
// Numbering: under construction first, then in development, then completed; then by the project's own order
const STAGE_RANK: Record<string, number> = { 'Under Construction': 0, 'In Development': 1, Complete: 2 };
const ordered = all.slice().sort((a, b) => (STAGE_RANK[a.data.stage ?? ''] ?? 3) - (STAGE_RANK[b.data.stage ?? ''] ?? 3) || a.data.order - b.data.order);
const unpinned = everything.filter((p) => p.data.lat == null || p.data.lng == null);
const pins = ordered.map((p, i) => ({ p, num: i + 1, x: X(p.data.lng!), y: Y(p.data.lat!), dx: 0, dy: 0, tight: false, color: brandInk(p) }));

// Pins within 80 map units of each other (they overlap at the full view on phones) (e.g. Merge Condos, Merge Spaces, Cliffside) fan out on short leader lines.
// Offsets are in screen pixels, so the fan stays the same size when zoomed.
const R = 13;
const used = new Set<number>();
for (let i = 0; i < pins.length; i++) {
  if (used.has(i)) continue;
  const group = pins.map((_, j) => j).filter((j) => !used.has(j) && Math.hypot(pins[j].x - pins[i].x, pins[j].y - pins[i].y) < 80);
  group.forEach((j) => used.add(j));
  if (group.length < 2) continue;
  // Buildings practically next door (under ~150 m apart) keep their fan at every zoom level
  group.forEach((j, k) => {
    pins[j].tight = group.some((b) => b !== j && Math.hypot(pins[j].x - pins[b].x, pins[j].y - pins[b].y) < 6);
    const ang = ((-130 + (100 / (group.length - 1)) * k) * Math.PI) / 180;
    pins[j].dx = +(40 * Math.cos(ang)).toFixed(1);
    pins[j].dy = +(40 * Math.sin(ang)).toFixed(1);
  });
}

const marks = mapData.landmarks.map((l) => ({ ...l, x: X(l.lng), y: Y(l.lat), pos: (l as { labelPos?: string }).labelPos ?? 'right' }));
const lx = (pos: string) => (pos === 'left' ? -10 : pos === 'right' ? 10 : 0);
const ly = (pos: string) => (pos === 'top' ? -11 : pos === 'bottom' ? 18 : 4);
const anchor = (pos: string) => (pos === 'left' ? 'end' : pos === 'right' ? 'start' : 'middle');
const L = geo.layers as Record<string, string>;
---

<section class="cmap section" id={id}>
  <div class="container">
    {(eyebrow || heading) && (
      <div class="cmap__head reveal">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {heading && <h2>{heading}</h2>}
        {body && <p class="lede">{body}</p>}
      </div>
    )}

    <div class="cmap__grid">
      <figure class="cmap__figure">
        <div class="cmap__frame" data-frame>
          <svg viewBox={`0 0 ${W} ${H}`} data-w={W} data-h={H} data-km={kmPx.toFixed(2)} role="img" aria-labelledby={`${id}-title`} class="cmap__svg" data-svg style="--k: 1">
            <title id={`${id}-title`}>Map of LCH Developments projects in east Toronto</title>
            <defs>
              {roadLabels.map((l, i) => <path id={`${id}-rl-${i}`} d={l.d} />)}
            </defs>
            <rect x="-2000" y="-2000" width="5000" height="5000" class="m-land" />
            <path d={L.park} class="m-park" />
            <path d={L.wood} class="m-wood" />
            <path d={L.water} class="m-water" />
            <path d={L.stream} class="m-stream" />
            <path d={L.river} class="m-river" />
            <path d={L.minor} class="m-minor" />
            <path d={L.tertiary} class="m-tertiary" />
            <path d={L.secondary} class="m-secondary" />
            <path d={L.primary} class="m-primary" />
            <path d={L.motorway} class="m-motorway" />
            <path d={L.rail} class="m-rail" />
            {geo.ontarioLine.map((d) => <path d={d} class="m-line3" />)}
            {L.lrt && <path d={L.lrt} class="m-line5" />}
            {L.lrtTunnel && <path d={L.lrtTunnel} class="m-line5" />}
            {geo.subwayLines.map((d) => <path d={d} class="m-line2" />)}
            {geo.kingston.map((k) => <path d={k} class="m-kingston-casing" />)}
            {geo.kingston.map((k) => <path d={k} class="m-kingston" />)}

            <g class="m-roadlabels">
              {roadLabels.map((l, i) => (
                <text class="m-roadlabel" dy="-4"><textPath href={`#${id}-rl-${i}`} startOffset="50%" text-anchor="middle">{l.name}</textPath></text>
              ))}
            </g>

            <g class="m-fixed" style={`transform: translate(${X(-79.2)}px, ${Y(43.705)}px) scale(calc(var(--k) * var(--ps, 1)))`}><text class="m-water-label" text-anchor="middle">Lake Ontario</text></g>
            <g class="m-fixed" style={`transform: translate(${X(-79.2155)}px, ${Y(43.7205)}px) scale(calc(var(--k) * var(--ps, 1)))`}><text class="m-shore-label" text-anchor="middle" transform="rotate(-50)">Scarborough Bluffs</text></g>

            {marks.filter((m) => m.kind === 'neighbourhood').map((m) => (
              <g class="m-fixed" style={`transform: translate(${m.x}px, ${m.y}px) scale(calc(var(--k) * var(--ps, 1)))`}>
                <text class="m-hood" x={lx(m.pos)} y={ly(m.pos)} text-anchor={anchor(m.pos)}>{m.name}</text>
              </g>
            ))}

            {marks.filter((m) => m.kind !== 'neighbourhood').map((m) => (
              <g class={`m-fixed m-poi m-poi--${m.kind}`} style={`transform: translate(${m.x}px, ${m.y}px) scale(calc(var(--k) * var(--ps, 1)))`}>
                <title>{m.name}{m.note ? ` (${m.note})` : ''}</title>
                {m.kind === 'nature' ? <path d="M0 -6L5.5 4H-5.5Z" /> : <rect x="-4.5" y="-4.5" width="9" height="9" />}
                <text x={lx(m.pos)} y={ly(m.pos)} text-anchor={anchor(m.pos)}>{m.name}</text>
              </g>
            ))}

            {subway.map((st) => (
              <g class="m-fixed m-station m-station--subway" style={`transform: translate(${st.x}px, ${st.y}px) scale(calc(var(--k) * var(--ps, 1)))`}>
                <title>{st.name} station (Line 2)</title>
                <circle r="4.5" />
                <text y="-9" text-anchor="middle" class="m-zoom-only">{st.name}</text>
              </g>
            ))}
            {lineBadges.map((b) => (
              <g class={`m-fixed m-linebadge m-linebadge--${b.cls}`} style={`transform: translate(${b.p!.x}px, ${b.p!.y}px) scale(calc(var(--k) * var(--ps, 1)))`}>
                <g transform={`translate(${b.dx} ${b.dy})`}>
                  <circle r="9" />
                  <text class="m-linebadge__n" y="3.8" text-anchor="middle">{b.n}</text>
                  <text class="m-linebadge__name" x="14" y="4">{b.name}</text>
                </g>
              </g>
            ))}
            {goStations.map((st) => (
              <g class="m-fixed m-station m-station--go" style={`transform: translate(${st.x}px, ${st.y}px) scale(calc(var(--k) * var(--ps, 1)))`}>
                <title>{st.name} GO</title>
                <rect x="-5" y="-5" width="10" height="10" rx="2" />
                <text x="9" y="4">{st.name} GO</text>
              </g>
            ))}

            {pins.map((pin) => (
              <g class:list={["m-fixed m-pin", { "m-pin--tight": pin.tight }]} style={`transform: translate(${pin.x}px, ${pin.y}px) scale(calc(var(--k) * var(--ps, 1)))`} data-pin={pin.p.id} data-x={pin.x} data-y={pin.y} tabindex="0" role="button" aria-label={`${pin.num}. ${pin.p.data.title}, ${pin.p.data.stage}`}>
                {(pin.dx || pin.dy) ? (
                  <>
                    <line x1="0" y1="0" x2={pin.dx} y2={pin.dy} class="m-leader" />
                    <circle r="3" class="m-dot" />
                  </>
                ) : null}
                <g class="m-pin__offset" transform={`translate(${pin.dx} ${pin.dy})`}>
                  <circle r={R} class="m-pin__circle" style={`fill: ${pin.color}`} />
                  <text y="4.5" text-anchor="middle" class="m-pin__num">{pin.num}</text>
                </g>
              </g>
            ))}
          </svg>

          <div class="cmap__scale" aria-hidden="true"><span data-scale-bar></span><em data-scale-label>2 km</em></div>
          <div class="cmap__controls" role="group" aria-label="Map zoom">
            <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
            <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
            <button type="button" data-zoom="reset" aria-label="Show whole map" class="cmap__reset">Reset</button>
          </div>
          <p class="cmap__hint" aria-hidden="true">Select a project to zoom in · drag to move</p>
        </div>
        <figcaption class="cmap__legend">
          <span><i class="lg lg--pin"></i>LCH project, in its brand colour</span>
          <span><i class="lg lg--road"></i>Kingston Road</span>
          <span><i class="lg lg--l2"></i>Line 2 Bloor-Danforth</span>
          <span><i class="lg lg--l5"></i>Line 5 Eglinton</span>
          <span><i class="lg lg--l3"></i>Line 3 Ontario Line (future)</span>
          <span><i class="lg lg--rail"></i>GO rail and station</span>
          <span><i class="lg lg--park"></i>Park, ravine or woodland</span>
          <span class="cmap__attr">Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors · © OpenMapTiles · OpenFreeMap</span>
        </figcaption>
      </figure>

      <div class="cmap__list">
        <ol class="cmap__items">
          {pins.map(({ p, num, color }) => {
            const m = latestMilestone(p);
            return (
              <li class="cmap__item" data-item={p.id} data-kind={isClientWork(p) ? 'client' : 'development'}>
                <button class="cmap__btn" data-select={p.id} aria-expanded="false">
                  <span class="cmap__num" style={`background: ${color}`}>{num}</span>
                  <span class="cmap__name">{p.data.title}</span>
                  <span class="cmap__stage">{isClientWork(p) ? 'Client work' : p.data.stage}</span>
                </button>
                <div class="cmap__detail" hidden>
                  {p.data.heroImage && <Img src={p.data.heroImage} alt="" sizes="320px" />}
                  <p class="cmap__addr">{p.data.address}<br />{p.data.neighbourhood}</p>
                  {p.data.leasing?.status && <p class="cmap__leasing" style={`color: ${color}`}>Leasing: {p.data.leasing.status}</p>}
                  {m && <p class="cmap__latest"><strong>{formatMilestoneDate(m.date)}</strong> {m.label}</p>}
                  <a class="link-arrow" href={`/projects/${p.id}/`}>View {p.data.title} →</a>
                </div>
              </li>
            );
          })}
          {unpinned.map((p) => (
            <li class="cmap__item cmap__item--unpinned" data-item={p.id} data-kind={isClientWork(p) ? 'client' : 'development'}>
              <a class="cmap__btn cmap__btn--link" href={`/projects/${p.id}/`}>
                <span class="cmap__num cmap__num--off" aria-hidden="true"></span>
                <span class="cmap__name">{p.data.title}<em>{p.data.neighbourhood} · outside this map</em></span>
                <span class="cmap__stage">{isClientWork(p) ? 'Client work' : p.data.stage}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.cmap').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const scaleBar = root.querySelector<HTMLElement>('[data-scale-bar]')!;
    const scaleLabel = root.querySelector<HTMLElement>('[data-scale-label]')!;
    const W = Number(svg.dataset.w), H = Number(svg.dataset.h);
    const KM = Number(svg.dataset.km);
    let vb = { x: 0, y: 0, w: W, h: H };
    const MIN = W / 10; // up to 10× zoom

    const updateScale = () => {
      const pxPerUnit = svg.getBoundingClientRect().width / vb.w;
      const kmOnScreen = KM * pxPerUnit;
      const nice = [0.25, 0.5, 1, 2, 5].find((d) => d * kmOnScreen >= 60) ?? 5;
      scaleBar.style.width = `${(nice * kmOnScreen).toFixed(0)}px`;
      scaleLabel.textContent = nice < 1 ? `${nice * 1000} m` : `${nice} km`;
    };
    const apply = () => {
      vb.w = Math.min(W, Math.max(MIN, vb.w));
      vb.h = (vb.w * H) / W;
      vb.x = Math.min(W - vb.w, Math.max(0, vb.x));
      vb.y = Math.min(H - vb.h, Math.max(0, vb.y));
      svg.setAttribute('viewBox', `${vb.x.toFixed(1)} ${vb.y.toFixed(1)} ${vb.w.toFixed(1)} ${vb.h.toFixed(1)}`);
      const zoom = vb.w / W; // 1 = whole map
      // --k = map units per screen pixel, so pins and labels keep the same on-screen size at any zoom and on any device
      const px = svg.getBoundingClientRect().width || W;
      svg.style.setProperty('--k', (vb.w / px).toFixed(4));
      svg.classList.toggle('is-zoomed', zoom < 0.75);
      svg.classList.toggle('is-close', zoom < 0.35);
      frame.classList.toggle('is-zoomed', zoom < 0.999);
      updateScale();
    };
    // Smoothly animate between views
    let raf = 0;
    const animateTo = (target: typeof vb) => {
      cancelAnimationFrame(raf);
      const from = { ...vb }, t0 = performance.now(), dur = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 450;
      const step = (now: number) => {
        const t = dur ? Math.min(1, (now - t0) / dur) : 1, e = 1 - (1 - t) ** 3;
        vb = { x: from.x + (target.x - from.x) * e, y: from.y + (target.y - from.y) * e, w: from.w + (target.w - from.w) * e, h: from.h + (target.h - from.h) * e };
        apply();
        if (t < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const zoomAt = (factor: number, cx = vb.x + vb.w / 2, cy = vb.y + vb.h / 2) => {
      const nw = Math.min(W, Math.max(MIN, vb.w / factor)), f = nw / vb.w;
      animateTo({ x: cx - (cx - vb.x) * f, y: cy - (cy - vb.y) * f, w: nw, h: (nw * H) / W });
    };
    const focus = (x: number, y: number, k = 0.28) => {
      const nw = W * k;
      animateTo({ x: x - nw / 2, y: y - (nw * H) / W / 2, w: nw, h: (nw * H) / W });
    };

    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) =>
      b.addEventListener('click', () => {
        if (b.dataset.zoom === 'in') zoomAt(1.7);
        else if (b.dataset.zoom === 'out') zoomAt(1 / 1.7);
        else animateTo({ x: 0, y: 0, w: W, h: H });
      }),
    );

    // Drag to pan, only once zoomed in, so the page still scrolls normally on phones
    let drag: { id: number; sx: number; sy: number; vx: number; vy: number; moved: boolean } | null = null;
    svg.addEventListener('pointerdown', (e) => {
      if (vb.w >= W - 0.5) return;
      cancelAnimationFrame(raf);
      drag = { id: e.pointerId, sx: e.clientX, sy: e.clientY, vx: vb.x, vy: vb.y, moved: false };
    });
    svg.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const scale = vb.w / svg.getBoundingClientRect().width;
      const dx = e.clientX - drag.sx, dy = e.clientY - drag.sy;
      if (!drag.moved && Math.hypot(dx, dy) > 4) { drag.moved = true; svg.setPointerCapture(e.pointerId); }
      if (drag.moved) { vb.x = drag.vx - dx * scale; vb.y = drag.vy - dy * scale; apply(); }
    });
    const end = () => setTimeout(() => (drag = null), 0);
    svg.addEventListener('pointerup', end);
    svg.addEventListener('pointercancel', end);
    svg.addEventListener('dblclick', (e) => {
      const pt = svg.createSVGPoint(); pt.x = e.clientX; pt.y = e.clientY;
      const p = pt.matrixTransform(svg.getScreenCTM()!.inverse());
      zoomAt(2, p.x, p.y);
    });
    addEventListener('resize', () => apply());

    const select = (id: string, { zoom = false, scroll = false } = {}) => {
      root.querySelectorAll<HTMLElement>('[data-item]').forEach((li) => {
        const on = li.dataset.item === id;
        li.classList.toggle('is-active', on);
        li.querySelector('.cmap__detail')?.toggleAttribute('hidden', !on);
        li.querySelector('button.cmap__btn')?.setAttribute('aria-expanded', String(on));
        if (on && scroll && matchMedia('(max-width: 960px)').matches) li.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
      root.querySelectorAll<SVGGElement>('[data-pin]').forEach((g) => {
        g.classList.toggle('is-active', g.dataset.pin === id);
        if (g.dataset.pin === id) {
          g.parentNode!.appendChild(g);
          if (zoom) focus(Number(g.dataset.x), Number(g.dataset.y));
        }
      });
    };
    root.querySelectorAll<SVGGElement>('[data-pin]').forEach((g) => {
      g.addEventListener('click', () => { if (!drag?.moved) select(g.dataset.pin!, { scroll: true }); });
      g.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(g.dataset.pin!, { zoom: true }); } });
      g.addEventListener('mouseenter', () => root.querySelector(`[data-item="${g.dataset.pin}"]`)?.classList.add('is-hover'));
      g.addEventListener('mouseleave', () => root.querySelector(`[data-item="${g.dataset.pin}"]`)?.classList.remove('is-hover'));
    });
    root.querySelectorAll<HTMLButtonElement>('[data-select]').forEach((b) => {
      b.addEventListener('click', () => select(b.dataset.select!, { zoom: true }));
      b.addEventListener('mouseenter', () => root.querySelector(`[data-pin="${b.dataset.select}"]`)?.classList.add('is-hover'));
      b.addEventListener('mouseleave', () => root.querySelector(`[data-pin="${b.dataset.select}"]`)?.classList.remove('is-hover'));
    });
    // Filters: All projects / LCH developments / Selected client work
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((chip) =>
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter!;
        root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        root.querySelectorAll<HTMLElement>('[data-kind]').forEach((li) => (li.hidden = f !== 'all' && li.dataset.kind !== f));
        root.querySelectorAll<SVGGElement>('[data-pin]').forEach((g) => {
          const li = root.querySelector<HTMLElement>(`[data-item="${g.dataset.pin}"]`);
          g.classList.toggle('is-filtered', !!li?.hidden);
        });
      }),
    );
    const first = root.querySelector<HTMLElement>('[data-item]');
    if (first) select(first.dataset.item!);
    apply();
  });
</script>

<style>
  .cmap__head { max-width: 760px; margin-bottom: clamp(32px, 4vw, 56px); }
  .cmap__head h2 { margin-bottom: 20px; }
  .cmap__grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(24px, 3vw, 40px); align-items: start; }
  .cmap__figure { margin: 0; min-width: 0; }
  .cmap__frame { position: relative; border-radius: var(--radius); border: 1px solid var(--line); overflow: hidden; background: #f1eee7; }
  .cmap__frame.is-zoomed .cmap__svg { cursor: grab; touch-action: none; }
  .cmap__frame.is-zoomed .cmap__svg:active { cursor: grabbing; }
  .cmap__svg { display: block; width: 100%; height: auto; font-family: var(--font-sans); user-select: none; -webkit-user-select: none; }

  /* Base map. Strokes keep their on-screen width at every zoom level. */
  .cmap__svg path, .cmap__svg line { vector-effect: non-scaling-stroke; }
  .m-land { fill: #f1eee7; }
  .m-park { fill: #dbe5cf; }
  .m-wood { fill: #c8d9b8; }
  .m-water { fill: #c6dbe4; }
