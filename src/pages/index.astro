---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import NewsCard from '../components/NewsCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CorridorMap from '../components/CorridorMap.astro';
import PressStrip from '../components/PressStrip.astro';
import SocialFeed from '../components/SocialFeed.astro';
import partnerships from '../data/partnerships.json';
import { settings, home, getProjects, getNews, getTeam, stageTone, latestMilestone, formatMilestoneDate, brandInk, brandFill, md } from '../lib/site';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured).slice(0, 4);
// Skip the stories already featured in the press strip so the two blocks don't repeat each other
const pressPicks = new Set(home.press?.picks ?? []);
const news = (await getNews()).filter((n) => !pressPicks.has(n.id)).slice(0, home.news.count || 3);
const h = home.hero;
const lb = home.leasingBand;
const lbProject = projects.find((p) => p.id === lb?.project);
const lbBrand = lbProject ? brandInk(lbProject) : '#0f3a2e';
const ext = (url: string) => url?.startsWith('http');
const teamCount = (await getTeam()).length;
// {years} counts from 2012, when the company started as Lifestyle Custom Homes
const yearsInOperation = new Date().getFullYear() - 2012;
const statVal = (v: string) => v.replaceAll('{team}', String(teamCount)).replaceAll('{years}', String(yearsInOperation));
const allById = Object.fromEntries((await getProjects()).map((x) => [x.id, x]));
const partnerDir = new Map<string, { note?: string; logo?: string; logoKeep?: boolean }>(partnerships.worked.groups.flatMap((g: any) => g.items).map((i: any) => [i.name, i]));
---

<Base overlay image={h.image}>
  <span class="home-snap-on" hidden></span>
  <section class="hero on-image">
    <Img src={h.image} alt="" loading="eager" fetchpriority="high" class="hero__bg" />
    {h.video && (
      <video class="hero__video" data-src={h.video} data-src-mobile={h.videoMobile || h.video} poster={h.videoPoster} muted loop playsinline autoplay preload="none" aria-hidden="true" tabindex="-1"></video>
    )}
    <div class="container hero__content">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1>{h.heading}</h1>
      <p class="hero__sub">{h.subheading}</p>
      <div class="hero__ctas">
        {h.primaryCta?.label && <a class="btn btn--light" href={h.primaryCta.url}>{h.primaryCta.label} <span class="arrow" aria-hidden="true">→</span></a>}
        {h.secondaryCta?.label && <a class="btn btn--ghost-light" href={h.secondaryCta.url}>{h.secondaryCta.label}</a>}
      </div>
    </div>
  </section>

  {home.stats?.length > 0 && (
    <section class="stats" aria-label="LCH at a glance">
      <div class="container">
        <dl class="stats__grid" style={`--n: ${home.stats.length}`}>
          {home.stats.map((st) => (
            <div class="stat">
              <dt class="stat__label">{st.label}</dt>
              <dd class="stat__value" data-count={statVal(st.value)}>{statVal(st.value)}</dd>
              {(st.projects?.length > 0 || st.extra?.length > 0) && (
                <dd class="stat__list">
                  {(st.projects ?? []).map((id) => allById[id]).filter(Boolean).map((pr) => (
                    <a href={`/projects/${pr.id}/`} style={`--dot: ${brandFill(pr)}`}>{st.names?.[pr.id] ?? pr.data.title}</a>
                  ))}
                  {(st.extra ?? []).map((t) => <span class="stat__x">{t}</span>)}
                </dd>
              )}
            </div>
          ))}
        </dl>
        {home.statsNote && <p class="stats__note">{home.statsNote}</p>}
      </div>
    </section>
  )}




  <section class="section overview">
    <div class="container overview__grid">
      <div class="reveal">
        <p class="eyebrow">{home.overview.eyebrow}</p>
        <h2>{home.overview.heading}</h2>
      </div>
      <div class="reveal">
        <div class="overview__body" set:html={md(home.overview.body)} />
        <a class="link-arrow" href={home.overview.ctaUrl}>{home.overview.ctaLabel} →</a>
      </div>
    </div>
    {home.overview.images?.length > 0 && (
      <div class="container ov-photos">
        {home.overview.images.map((im, i) => {
          const Tag = im.url ? 'a' : 'figure';
          return (
            <Tag class={`ov-photo ov-photo--${i} reveal`} href={im.url || undefined}>
              <div class="ov-photo__img"><Img src={im.image} alt={im.alt} sizes="(max-width: 760px) 100vw, 40vw" /></div>
              {im.caption && <span class="ov-photo__cap">{im.caption}{im.url && <span aria-hidden="true"> →</span>}</span>}
            </Tag>
          );
        })}
      </div>
    )}
  </section>


  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--wide reveal">
        <p class="eyebrow">{home.featured.eyebrow}</p>
        <h2>{home.featured.heading}</h2>
      </div>

      <div class="features">
        {featured.map((p) => {
          const facts = [p.data.address, p.data.partners.length ? `with ${p.data.partners.join(', ')}` : null].filter(Boolean);
          return (
            <article class="feature reveal" style={`--fb: ${brandInk(p)}; ${p.data.tileCrop ?? ''}`}>
              <a class="feature__media" href={`/projects/${p.id}/`} tabindex="-1" aria-hidden="true">
                <Img src={p.data.heroImage} alt="" sizes="(max-width: 900px) 100vw, 1200px" />
              </a>
              <span class="feature__pills">
                <span class="pill" data-tone={stageTone(p.data.stage)}>{p.data.stage}</span>
                {p.data.leasing?.status && <span class="pill pill--leasing">{p.data.leasing.status}</span>}
                {p.data.delivery && <span class="pill pill--delivery">Delivery {p.data.delivery}</span>}
              </span>
              <div class="feature__panel">
                {p.data.logo?.endsWith('.svg')
                  ? <h3 class="feature__brand"><img src={p.data.logo} alt={p.data.title} loading="lazy" /></h3>
                  : <h3 class="feature__title display">{p.data.title}</h3>}
                <p class="feature__summary">{p.data.summary}</p>
                <p class="feature__facts">{facts.join('\n')}</p>
                {p.data.schedule?.length > 0 && (
                  <div class="fprog" data-schedule={JSON.stringify(p.data.schedule)} hidden>
                    <div class="fprog__top"><span class="fprog__label">Construction schedule</span><span class="fprog__pct"></span></div>
                    <div class="fprog__bar"><span></span></div>
                    <p class="fprog__now"></p>
                  </div>
                )}
                <div class="feature__links">
                  <a class="btn btn--light" href={`/projects/${p.id}/`}>View project <span class="arrow" aria-hidden="true">→</span></a>
                  {p.data.leasing?.url && <a class="link-arrow link-arrow--light" href={p.data.leasing.url} target="_blank" rel="noopener">Leasing at {p.data.leasing.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} ↗</a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <CorridorMap eyebrow={home.map.eyebrow} heading={home.map.heading} body={home.map.body} />

  {home.elevate && (
    <section class="section section--dark elevate" id="lch-elevate">
      <div class="container">
        <div class="elevate__top">
          <div class="reveal">
            <a class="elevate__logo" href={settings.elevate.url} target="_blank" rel="noopener" aria-label="Elevate Construction Management website"><img src={settings.elevate.logoLight} alt="Elevate Construction Management" width="200" height="98" loading="lazy" /></a>
            <p class="eyebrow">{home.elevate.eyebrow}</p>
            <h2>{home.elevate.heading}</h2>
            <div class="elevate__body" set:html={md(home.elevate.body)} />
            <div class="elevate__ctas">
              <a class="btn btn--light" href={home.elevate.ctaUrl}>{home.elevate.ctaLabel} <span class="arrow" aria-hidden="true">→</span></a>
              <a class="btn btn--ghost-light" href={home.elevate.extUrl} target="_blank" rel="noopener">{home.elevate.extLabel} <span class="arrow" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="elevate__media reveal">
            <Img src={home.elevate.image} alt={home.elevate.imageAlt} sizes="(max-width: 900px) 100vw, 45vw" />
          </div>
        </div>
        <div class="roles">
          <div class="role reveal">
            <p class="role__who">LCH leads</p>
            <ul>{home.elevate.lch.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="role reveal">
            <p class="role__who">Elevate leads</p>
            <ul>{home.elevate.elevateList.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>
  )}

  {lb?.enabled && (
    <section class="leasing on-image" style={`--brand: ${lbBrand}`}>
      {(lb.images?.length ? lb.images : [lb.image]).map((src, i, arr) => (
        <Img src={src} alt="" class="leasing__bg" sizes="100vw" loading="lazy" style={arr.length > 1 ? `--i: ${i}; --n: ${arr.length}` : undefined} />
      ))}
      <div class="container leasing__inner">
        <div>
          <p class="eyebrow">{lb.eyebrow}</p>
          <h2>{lb.heading}</h2>
          <p class="leasing__body">{lb.body}</p>
        </div>
        <a class="btn btn--light leasing__cta" href={lb.ctaUrl} target={ext(lb.ctaUrl) ? '_blank' : undefined} rel="noopener">{lb.ctaLabel} <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>
  )}





  {home.clients?.names?.length > 0 && (
    <section class="clients section--tight" aria-labelledby="clients-h">
      <div class="container">
        <div class="clients__head">
          <div>
            <p class="eyebrow">{home.clients.eyebrow}</p>
            <h2 id="clients-h" class="clients__h">{home.clients.heading}</h2>
          </div>
          {home.clients.ctaUrl && <a class="link-arrow" href={home.clients.ctaUrl}>{home.clients.ctaLabel} →</a>}
        </div>
        <div class="marquee" aria-label="Partners and clients">
          <div class="marquee__track">
            {[0, 1].map((copy) => (
              <ul class="marquee__list" aria-hidden={copy === 1 ? 'true' : undefined}>
                {home.clients.names.map((name) => {
                  const c = partnerDir.get(name);
                  return (
                    <li class="marquee__item" title={c?.note ? `${name}: ${c.note}` : name}>
                      {c?.logo ? <img src={c.logo} alt={copy === 0 ? name : ''} loading="lazy" class={c.logoKeep ? 'logo--keep' : undefined} /> : <span class="clients__word">{name}</span>}
                    </li>
                  );
                })}
              </ul>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <PressStrip eyebrow={home.press?.eyebrow} heading={home.press?.heading} picks={home.press?.picks ?? []} />

  {news.length > 0 && (
    <section class="section section--alt news-home">
      <div class="container">
        <div class="section-head section-head--row reveal">
          <div>
            <p class="eyebrow">{home.news.eyebrow}</p>
            <h2>{home.news.heading}</h2>
          </div>
          <a class="link-arrow" href="/news/">All news →</a>
        </div>
        <div class="grid-3">
          {news.map((n) => <NewsCard post={n} />)}
        </div>
      </div>
    </section>
  )}


  {home.business && (
    <section class="business">
      <div class="container business__inner">
        <div>
          <h2>{home.business.heading}</h2>
          <p class="lede">{home.business.body}</p>
        </div>
        <div class="business__ctas">
          <a class="btn" href={home.business.ctaUrl}>{home.business.ctaLabel} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={home.business.secondaryUrl}>{home.business.secondaryLabel}</a>
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  // Hero film: load the right size for the screen; visitors who prefer reduced motion keep the still photo
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero__video');
  if (heroVideo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroVideo.src = (innerWidth < 900 ? heroVideo.dataset.srcMobile : heroVideo.dataset.src) || '';
    heroVideo.addEventListener('playing', () => heroVideo.classList.add('is-playing'), { once: true });
    heroVideo.play().catch(() => {});
  }

  // Live construction progress on the project tiles, worked out from each project's schedule on every visit
  const monthYear = (d: Date) => d.toLocaleDateString('en-CA', { month: 'long', year: 'numeric' });
  document.querySelectorAll<HTMLElement>('.fprog[data-schedule]').forEach((el) => {
    const phases = (JSON.parse(el.dataset.schedule || '[]') as { name: string; start: string; end: string }[])
      .map((ph) => ({ ...ph, s: new Date(ph.start + 'T00:00:00'), e: new Date(ph.end + 'T23:59:59') }))
      .sort((a, b) => +a.s - +b.s);
    if (!phases.length) return;
    const now = new Date(), first = phases[0].s, last = phases.reduce((m, ph) => (ph.e > m ? ph.e : m), phases[0].e);
    if (now > last) return;
    const pct = Math.max(0, Math.min(100, ((+now - +first) / (+last - +first)) * 100));
    const current = phases.filter((ph) => ph.s <= now && now <= ph.e).pop();
    const next = phases.find((ph) => ph.s > now);
    el.querySelector<HTMLElement>('.fprog__pct')!.textContent = now < first ? 'Starting soon' : `${Math.round(pct)}% through`;
    el.querySelector<HTMLElement>('.fprog__bar span')!.style.setProperty('--p', `${pct}%`);
    el.querySelector<HTMLElement>('.fprog__now')!.textContent = current
      ? `Now: ${current.name}${next ? ` · Next: ${next.name}, ${monthYear(next.s)}` : ''}`
      : next ? `Next: ${next.name}, ${monthYear(next.s)}` : '';
    el.hidden = false;
  });

  // Count the stats up from zero when they scroll into view (instant for reduced-motion visitors)
  const countUp = (el: HTMLElement) => {
    const raw = el.dataset.count ?? '';
    const m = raw.match(/^([\d,]+)(.*)$/);
    const target = m ? Number(m[1].replace(/,/g, '')) : NaN;
    const suffix = m ? m[2] : '';
    if (!Number.isFinite(target) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const fmt = (n: number) => (raw.includes(',') ? Math.round(n).toLocaleString('en-CA') : String(Math.round(n))) + suffix;
    const t0 = performance.now(), dur = 1400;
    const tick = (now: number) => {
      const t = Math.max(0, Math.min(1, (now - t0) / dur)), e = 1 - Math.pow(1 - t, 3);
      el.textContent = fmt(target * e);
      if (t < 1) requestAnimationFrame(tick); else el.textContent = raw;
    };
    el.textContent = fmt(0);
    requestAnimationFrame(tick);
    setTimeout(() => { el.textContent = raw; }, dur + 200); // always land on the real number
  };
  const statIO = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (e.isIntersecting) { countUp(e.target as HTMLElement); statIO.unobserve(e.target); }
  }), { threshold: 0.6 });
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => statIO.observe(el));

  // Keep the stats band inside the first screen: the hero takes the viewport minus the band's height.
  const statsEl = document.querySelector<HTMLElement>('.stats');
  const setStatsH = () => { if (statsEl) document.documentElement.style.setProperty('--stats-h', `${statsEl.offsetHeight}px`); };
  setStatsH();
  addEventListener('resize', setStatsH);

  // Hero text drifts up and fades as the visitor scrolls past it (desktop, motion allowed)
  const heroContent = document.querySelector<HTMLElement>('.hero__content');
  if (heroContent && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const drift = () => {
      ticking = false;
      const y = Math.min(scrollY, innerHeight);
      heroContent.style.transform = `translate3d(0, ${y * 0.22}px, 0)`;
      heroContent.style.opacity = String(Math.max(0, 1 - y / (innerHeight * 0.75)));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(drift); } }, { passive: true });
  }
  if (statsEl && 'ResizeObserver' in window) new ResizeObserver(setStatsH).observe(statsEl);
</script>



<style>
  .hero { position: relative; overflow: hidden; height: calc(100svh - var(--announce-h) - var(--stats-h, 170px)); min-height: 520px; display: flex; align-items: flex-end; color: var(--paper); isolation: isolate; padding-block: calc(var(--header-h) + 32px) clamp(40px, 8vh, 96px); }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(10, 10, 9, 0.5) 0%, rgba(10, 10, 9, 0.08) 38%, rgba(10, 10, 9, 0.72) 100%); }
  :global(.hero__bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; animation: heroZoom 14s var(--ease) both; }
  /* Frame the Everston building to the right of the hero text, a little higher in the shot */
  @keyframes heroZoom { from { transform: translate(var(--hx, 0), var(--hy, 0)) scale(calc(var(--hs, 1) * 1.06)); } to { transform: translate(var(--hx, 0), var(--hy, 0)) scale(var(--hs, 1)); } }
  @media (min-width: 901px) { :global(.hero__bg) { --hs: 1.3; --hx: 14%; --hy: -9%; transform: translate(var(--hx), var(--hy)) scale(var(--hs)); } }
  .hero h1 { max-width: 13ch; font-size: clamp(34px, 3.9vw, 56px); }
  .hero__sub { font-size: clamp(16px, 1.3vw, 19px); max-width: 46ch; margin-top: 18px; color: rgba(246, 244, 239, 0.86); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .stats { background: var(--ink); color: var(--paper); padding-block: clamp(22px, 2.6vw, 34px); }
  .stats__grid { display: grid; grid-template-columns: repeat(var(--n, 4), 1fr); margin: 0; }
  .stat { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 10px; padding: 4px clamp(16px, 2.5vw, 36px); border-left: 1px solid rgba(246, 244, 239, 0.18); }
  .stat:first-child { padding-left: 0; border-left: 0; }
  .stat__value { margin: 0; font-size: clamp(34px, 3.6vw, 52px); font-weight: 600; letter-spacing: -0.045em; line-height: 0.95; font-variant-numeric: tabular-nums; }
  .stat__label { font-size: 14px; font-weight: 600; letter-spacing: 0.02em; color: rgba(246, 244, 239, 0.7); max-width: 18ch; }
  .stat { display: flex; flex-direction: column; justify-content: flex-start; }
  .stat .stat__value { order: -1; }
  .stat__list { margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12.5px; }
  .stat__list a, .stat__x { display: inline-flex; align-items: center; gap: 8px; color: rgba(246, 244, 239, 0.78); text-decoration: none; }
  .stat__list a::before, .stat__x::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--dot, rgba(246, 244, 239, 0.4)); box-shadow: 0 0 0 1px rgba(246, 244, 239, 0.35); flex: none; }
  .stat__list a span { color: rgba(246, 244, 239, 0.5); font-variant-numeric: tabular-nums; }
  .stat__list a:hover { color: #fff; }
  @media (min-width: 901px) and (max-height: 820px) { .stat__list { display: none; } .hero { min-height: 400px; padding-bottom: 32px; } .hero h1 { font-size: clamp(40px, 7.5vh, 64px); } .hero__sub { margin-top: 14px; font-size: 17px; } .hero__ctas { margin-top: 20px; } }
  .stats__note { margin: clamp(22px, 2.6vw, 32px) 0 0; padding-top: 14px; border-top: 1px solid rgba(246, 244, 239, 0.14); font-size: 12.5px; color: rgba(246, 244, 239, 0.5); }

  .section-head { margin-bottom: clamp(28px, 3.5vw, 48px); }
  .section-head h2 { max-width: 34ch; }
  @media (min-width: 961px) { .section-head--wide h2 { max-width: none; white-space: nowrap; } }
  .section-head--row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }

  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 1.6vw, 20px); }
  .feature { position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 3 / 4.2; min-height: 520px; display: flex; align-items: flex-end; color: #fff; isolation: isolate; }
  .feature__media { position: absolute; inset: 0; z-index: -2; }
  .feature__media { overflow: hidden; }
  .feature__media :global(img) { position: absolute; left: 0; top: var(--tile-top, 0); width: 100%; height: var(--tile-h, 100%); object-fit: cover; object-position: var(--tile-x, 50%) 50%; transition: transform 1.4s var(--ease); }
  .feature:hover .feature__media :global(img) { transform: scale(1.04); }
  .feature::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(0deg, color-mix(in srgb, var(--fb) 96%, transparent) 0%, color-mix(in srgb, var(--fb) 80%, transparent) 38%, color-mix(in srgb, var(--fb) 20%, transparent) 66%, transparent 82%); }
  .feature__panel { position: relative; width: 100%; padding: clamp(20px, 2.2vw, 30px); display: grid; gap: 10px; }
  .feature__pills { position: absolute; top: clamp(16px, 1.8vw, 24px); left: clamp(16px, 1.8vw, 24px); right: 16px; display: flex; flex-wrap: wrap; gap: 6px; }
  .feature__brand { margin: 0; line-height: 0; }
  .feature__brand img { height: clamp(30px, 2.8vw, 42px); width: auto; max-width: 240px; filter: brightness(0) invert(1); }
  .feature__title { font-size: clamp(28px, 2.6vw, 38px); margin: 0; color: #fff; }
  .feature__summary { font-size: 15.5px; line-height: 1.5; margin: 0; color: rgba(255, 255, 255, 0.9); }
  .feature__facts { margin: 0; font-size: 13px; line-height: 1.6; color: rgba(255, 255, 255, 0.75); white-space: pre-wrap; }
  .feature__links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 6px; }
  .feature__links .btn { padding-block: 10px; font-size: 14px; }
  .feature__links .link-arrow { font-size: 14px; }
  .link-arrow--light { color: #fff; }

  .philosophy__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .philosophy h2 { font-size: clamp(32px, 3.6vw, 52px); margin-bottom: 28px; }
  .philosophy .lede { margin-bottom: 36px; }
  .philosophy__media { border-radius: var(--radius); overflow: hidden; }
  .philosophy__media :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }

  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 3vw, 44px); }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(24px, 2.5vw, 36px); }
  .grid-4 :global(.pcard__title) { font-size: 24px; }
  .grid-4 :global(.pcard__summary) { font-size: 15px; }

  @media (max-width: 1100px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
