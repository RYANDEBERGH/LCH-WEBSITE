---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { corporate } from '../lib/site';
---

<Base title={corporate.heading}>
  <PageHero eyebrow="LCH Developments" heading={corporate.heading} lede={corporate.intro} />
  <section class="section--tight" style="padding-top:0">
    <div class="container">
      <ul class="entities">{corporate.entities.map((e) => <li>{e}</li>)}</ul>
    </div>
  </section>
</Base>

<style>
  .entities { list-style: none; padding: 0; margin: 0; max-width: 760px; }
  .entities li { padding: 20px 0; border-top: 1px solid var(--line); font-size: 20px; }
  .entities li:last-child { border-bottom: 1px solid var(--line); }
</style>
