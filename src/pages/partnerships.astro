---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import { partnerships as P, getProjects, stageTone } from '../lib/site';

const projects = await getProjects();
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));
---

<Base title="Partnerships" description="LCH Developments works with capital partners, co-developers, community institutions and its affiliated construction manager, Elevate.">
  <PageHero eyebrow={P.eyebrow} heading={P.heading} lede={P.intro} />

  <section style="padding-bottom: clamp(72px, 10vw, 144px)">
    <div class="container">
      <ul class="partners">
        {P.partners.map((pt) => (
          <li class="partner reveal">
            <div class="partner__head">
              <p class="partner__role">{pt.role}</p>
              <h2 class="partner__name">{pt.name}</h2>
            </div>
            <div class="partner__body">
              <p>{pt.body}</p>
              {pt.quote && (
                <blockquote>
                  <p>“{pt.quote}”</p>
                  {pt.quoteBy && <footer>{pt.quoteBy}</footer>}
                </blockquote>
              )}
              {pt.linkUrl && <a class="link-arrow" href={pt.linkUrl} target="_blank" rel="noopener">{pt.linkLabel || 'Learn more'} ↗</a>}
            </div>
            <div class="partner__projects">
              {pt.projects.map((id) => byId[id]).filter(Boolean).map((p) => (
                <a class="pp" href={`/projects/${p.id}/`}>
                  <Img src={p.data.heroImage} alt="" sizes="160px" />
                  <span>
                    <strong>{p.data.title}</strong>
                    <em><i class="dot" data-tone={stageTone(p.data.stage)}></i>{p.data.stage}</em>
                  </span>
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <p class="eyebrow">{P.workWithUs.heading}</p>
      <div class="wwu">
        {P.workWithUs.items.map((it) => (
          <div class="wwu__item reveal">
            <h3 class="display">{it.title}</h3>
            <p>{it.body}</p>
          </div>
        ))}
      </div>
      <a class="btn btn--light" href={P.workWithUs.ctaUrl}>{P.workWithUs.ctaLabel} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .partners { list-style: none; margin: 0; padding: 0; }
  .partner { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3fr); gap: clamp(24px, 4vw, 56px); padding: 40px 0; border-top: 1px solid var(--line); align-items: start; }
  .partner:last-child { border-bottom: 1px solid var(--line); }
  .partner__role { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .partner__name { font-size: clamp(32px, 3.2vw, 46px); }
  .partner__body p { color: var(--ink-2); }
  .partner__body blockquote { margin: 20px 0; padding-left: 18px; border-left: 2px solid var(--accent); }
  .partner__body blockquote p { font-family: var(--font-display); font-size: 22px; line-height: 1.3; margin-bottom: 8px; color: var(--ink); }
  .partner__body blockquote footer { font-size: 13px; color: var(--muted); }
  .partner__projects { display: grid; gap: 10px; }
  .pp { display: grid; grid-template-columns: 72px 1fr; gap: 12px; align-items: center; text-decoration: none; padding: 6px; border-radius: var(--radius); transition: background 0.2s; }
  .pp:hover { background: var(--paper-2); }
  .pp :global(img) { width: 72px; height: 54px; object-fit: cover; border-radius: 3px; }
  .pp span { display: grid; gap: 2px; }
  .pp strong { font-weight: 600; font-size: 15px; }
  .pp em { font-style: normal; font-size: 13px; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #8a8680; display: inline-block; }
  .dot[data-tone='build'] { background: #e09a1d; }
  .dot[data-tone='soon'] { background: var(--accent); }

  .wwu { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 56px); margin: 8px 0 40px; }
  .wwu__item { border-top: 1px solid rgba(246, 244, 239, 0.2); padding-top: 24px; }
  .wwu__item h3 { font-size: clamp(28px, 2.6vw, 36px); margin-bottom: 14px; }
  .wwu__item p { color: rgba(246, 244, 239, 0.75); font-size: 16px; }

  @media (max-width: 1000px) {
    .partner { grid-template-columns: 1fr 1fr; }
    .partner__projects { grid-column: 1 / -1; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  }
  @media (max-width: 680px) {
    .partner, .wwu { grid-template-columns: 1fr; }
  }
</style>
