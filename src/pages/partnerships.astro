---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { story, settings } from '../lib/site';
import { partnerships as P, getTeam, getProjects, stageTone, brandInk, isClientWork } from '../lib/site';

const projects = await getProjects();
const teamCount = (await getTeam()).length;
const CHIPS = ['Consultants we’ve worked with', 'Trades we’ve worked with'];
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));
---

<Base title="Work with us" description="Development management, construction management and project recovery for owners, institutions, lenders and receivers, from LCH Developments and Elevate.">
  <section class="phead">
    <div class="container phead__grid">
      <div>
        <p class="eyebrow">{P.eyebrow}</p>
        <h1>{P.heading}</h1>
        <p class="lede">{P.intro}</p>
        <a class="btn" href="#partner-form">{P.form.heading} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <dl class="proof">
        {P.proof.map((p) => (
          <div class="proof__item">
            <dt class="display">{p.logo ? <img class="proof__logo" src={p.logo} alt={p.value} /> : p.value.replaceAll('{team}', String(teamCount)).replaceAll('{years}', String(new Date().getFullYear() - 2012))}</dt>
            <dd>{p.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--alt" id="services">
    <div class="container">
      <h2 class="sec-h reveal">{P.audiences.heading}</h2>
      {P.audiences.groups.map((g) => (
        <div class="aud-group">
          {g.label && <p class="aud-group__label">{g.label}</p>}
          <div class="aud">
            {g.items.map((it) => (
              <article class="aud__item reveal">
                <h3 class="display">{it.title}</h3>
                <p>{it.body}</p>
                <a class="link-arrow" href="#partner-form" data-type={it.type}>{it.cta} →</a>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="sec-h reveal">{P.reasons.heading}</h2>
      <ol class="reasons">
        {P.reasons.items.map((r, i) => (
          <li class="reason reveal">
            <span class="reason__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <p class="eyebrow">{story.experience.eyebrow}</p>
      <h2 class="sec-h">{story.experience.heading}</h2>
      <div class="cases">
        {story.experience.items.map((c) => (
          <article class="case reveal">
            {c.image && <div class="case__img"><Img src={c.image} alt={c.imageAlt ?? ''} sizes="(max-width: 680px) 100vw, 33vw" /></div>}
            <p class="case__role">{c.role}</p>
            <h3>{c.title}</h3>
            <p class="case__lead">{c.heading}</p>
            <p>{c.body}</p>
            {c.points?.length > 0 && <ul class="case__points">{c.points.map((pt) => <li>{pt}</li>)}</ul>}
            {c.project && <a class="link-arrow" href={`/projects/${c.project}/`}>View {c.title} →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt worked" id="partners">
    <div class="container">
      <p class="eyebrow">{P.worked.eyebrow}</p>
      <h2 class="sec-h">{P.worked.heading}</h2>
      <p class="lede worked__intro">{P.worked.intro}</p>
      <ul class="logos">
        {P.worked.groups.filter((g) => !CHIPS.includes(g.label)).flatMap((g) => g.items).map((it) => {
          const linked = it.projects.map((id) => byId[id]).filter(Boolean);
          const label = [it.note, linked.map((pr) => pr.data.title).join(', ')].filter(Boolean).join(' · ');
          return (
            <li class="logos__item reveal" title={label ? `${it.name}: ${label}` : it.name}>
              {it.logo ? <img src={it.logo} alt={it.name} loading="lazy" class={it.logoKeep ? 'logo--keep' : undefined} /> : <span class="logos__word">{it.name}</span>}
            </li>
          );
        })}
      </ul>
      {P.worked.teamsNote && <p class="trades__note">{P.worked.teamsNote}</p>}
      {P.worked.groups.filter((g) => CHIPS.includes(g.label)).map((g) => (
        <details class="trades reveal" open data-collapse-mobile>
          <summary class="trades__label">{g.label} <span class="trades__count">{g.items.length}</span></summary>
          <ul class="trades__list">
            {g.items.map((it) => <li title={[it.note, it.projects.map((id) => byId[id]?.data.title).filter(Boolean).join(', ')].filter(Boolean).join(' · ')}>{it.name}</li>)}
          </ul>
        </details>
      ))}
    </div>
  </section>

  <section class="section section--dark">
    <div class="container track">
      <div class="track__head">
        <p class="eyebrow">Track record</p>
        <h2>Our developments and selected client work.</h2>
      </div>
      <ul class="track__list">
        {projects.map((p) => (
          <li>
            <a href={`/projects/${p.id}/`} class="tp" style={`--brand: ${brandInk(p)}`}>
              {p.data.heroImage ? <Img src={p.data.heroImage} alt="" sizes="(max-width: 700px) 50vw, 25vw" /> : <span class="tp__ph" aria-hidden="true">{p.data.neighbourhood}</span>}
              <span class="tp__body">
                <strong>{p.data.title}</strong>
                <em>{isClientWork(p) ? p.data.roleLabel : p.data.type}{p.data.units ? ` · ${p.data.units.toLocaleString()} homes` : ''}</em>
                {isClientWork(p) ? <span class="pill pill--client-dark">Selected client work</span> : p.data.stage && <span class="pill" data-tone={stageTone(p.data.stage)}>{p.data.stage}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section scope" id="scope">
    <div class="container">
      <div class="scope__head">
        <div>
          <p class="eyebrow">{P.scope.eyebrow}</p>
          <h2 class="sec-h">{P.scope.heading}</h2>
        </div>
        <p class="lede">{P.scope.intro}</p>
      </div>

      <div class="scope__cards">
        <article class="scard scard--lch reveal">
          <header class="scard__head">
            <img class="scard__logo" src={settings.logo} alt="LCH Developments" loading="lazy" />
            <h3>{P.scope.dmLabel}</h3>
            {P.scope.dmIntro && <p>{P.scope.dmIntro}</p>}
          </header>
          {P.scope.dmGroups?.length ? (
            <ol class="scard__phases scard__phases--lch">
              {P.scope.dmGroups.map((g, gi) => {
                const start = P.scope.dmGroups.slice(0, gi).reduce((n, x) => n + x.count, 0);
                return (
                  <li>
                    <p class="scard__pnum">Stage {gi + 1}</p>
                    <h4>{g.title}</h4>
                    <ul>{P.scope.dm.slice(start, start + g.count).map((r) => <li title={r.body}>{r.title}</li>)}</ul>
                  </li>
                );
              })}
            </ol>
          ) : (
            <ol class="scard__list">
              {P.scope.dm.map((r, i) => <li title={r.body}><span>{String(i + 1).padStart(2, '0')}</span>{r.title}</li>)}
            </ol>
          )}
        </article>
        <article class="scard scard--elevate reveal">
          <header class="scard__head">
            <img class="scard__logo" src={settings.elevate.logoLight} alt="Elevate Construction Management" loading="lazy" />
            <h3>{P.scope.cmLabel}</h3>
            {P.scope.cmIntro && <p>{P.scope.cmIntro}</p>}
          </header>
          <ol class="scard__phases">
            {P.scope.cm.map((ph, i) => (
              <li>
                <p class="scard__pnum">Phase {i + 1}</p>
                <h4>{ph.title}</h4>
                <ul>{ph.items.map((x) => <li>{x}</li>)}</ul>
              </li>
            ))}
          </ol>
          {P.scope.cmNote && <p class="scope__note">{P.scope.cmNote}</p>}
        </article>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="partner-form">
    <div class="container formwrap">
      <div>
        <p class="eyebrow">Partner with LCH</p>
        <h2>{P.form.heading}</h2>
        <p class="lede">{P.form.intro}</p>
      </div>
      <form class="pform" name="partnerships" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="company">
        <input type="hidden" name="form-name" value="partnerships" />
        <p class="hidden-field"><label>Leave this field empty: <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field">
          <label for="pf-type">I am a</label>
          <select id="pf-type" name="partner_type" data-type-select>
            {P.form.types.map((t) => <option>{t}</option>)}
          </select>
        </div>
        <div class="row">
          <div class="field"><label for="pf-name">Name</label><input id="pf-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="pf-org">Organization <span class="opt">(optional)</span></label><input id="pf-org" name="organization" autocomplete="organization" /></div>
        </div>
        <div class="row">
          <div class="field"><label for="pf-email">Email</label><input id="pf-email" type="email" name="email" autocomplete="email" required /></div>
          <div class="field"><label for="pf-phone">Phone <span class="opt">(optional)</span></label><input id="pf-phone" type="tel" name="phone" autocomplete="tel" /></div>
        </div>
        <div class="field"><label for="pf-site">Site address or opportunity <span class="opt">(optional)</span></label><input id="pf-site" name="site" /></div>
        <div class="field"><label for="pf-msg">Tell us more</label><textarea id="pf-msg" name="message" required></textarea></div>
        <button class="btn" type="submit">Send <span class="arrow" aria-hidden="true">→</span></button>
      </form>
    </div>
  </section>
</Base>

<script>
  // Phones: start the long consultant and trade lists collapsed
  if (matchMedia('(max-width: 700px)').matches) document.querySelectorAll('details[data-collapse-mobile]').forEach((d) => d.removeAttribute('open'));

  // "Tell us about a site" etc. pre-select the matching partner type in the form
  const sel = document.querySelector<HTMLSelectElement>('[data-type-select]');
  document.querySelectorAll<HTMLAnchorElement>('[data-type]').forEach((a) =>
    a.addEventListener('click', () => { if (sel) sel.value = a.dataset.type!; }),
  );
</script>

<style>
  .scope__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(20px, 4vw, 64px); align-items: end; margin-bottom: clamp(24px, 3vw, 40px); }
  .scope__head .sec-h { margin-bottom: 0; }
  .scope__head .lede { margin: 0; }
  .scope__block { margin-top: clamp(24px, 3vw, 40px); }
  .scope__label { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); margin: 0 0 12px; padding-left: 10px; border-left: 3px solid var(--ink); }
  .scope__label--elevate { border-left-color: #1f4d3a; color: #1f4d3a; }
  .scope__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 28px; border-top: 2px solid var(--ink); }
  .scope__list li { padding: 13px 0; border-bottom: 1px solid var(--line); font-weight: 600; font-size: 16px; display: flex; gap: 12px; align-items: baseline; }
  .scope__list li span { font-size: 12px; font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; }
  .scope__table { margin: 0; border-top: 2px solid var(--ink); }
  .scope__row { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(16px, 3vw, 40px); padding: 14px 0; border-bottom: 1px solid var(--line); }
  .scope__row dt { font-weight: 700; font-size: 16px; display: flex; gap: 12px; align-items: baseline; }
  .scope__row dt span { font-size: 12px; font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; }
  .scope__row dd { margin: 0; color: var(--ink-2); font-size: 15px; line-height: 1.55; }
  .scope__phases { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .scope__phase { background: #1f4d3a; color: #fff; padding: 20px 22px 22px; }
  .scope__phase:nth-child(2) { background: #173d2e; }
  .scope__phase:nth-child(3) { background: #10301f; }
  .scope__pnum { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: .65; margin: 0 0 4px; }
  .scope__phase h3 { font-size: 20px; margin: 0 0 12px; color: #fff; }
  .scope__phase ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14.5px; color: rgba(255,255,255,.88); }
  .scope__phase li { padding-left: 16px; position: relative; }
  .scope__phase li::before { content: ''; position: absolute; left: 0; top: 9px; width: 6px; height: 1.5px; background: currentColor; }
  .scope__note { margin: 12px 0 0; font-size: 15px; color: var(--muted); font-style: italic; }
  .scope__fit { margin-top: clamp(28px, 3.5vw, 44px); }
  .scope__fit ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .scope__fit li { padding: 12px 14px; background: var(--white); border: 1px solid var(--line); font-size: 15px; border-radius: 2px; }
  @media (max-width: 900px) { .scope__list { grid-template-columns: 1fr 1fr; } .scope__head, .scope__row { grid-template-columns: 1fr; } .scope__row { gap: 4px; } .scope__phases, .scope__fit ul { grid-template-columns: 1fr; } }

  .case__points { margin: 4px 0 8px; padding-left: 18px; display: grid; gap: 6px; font-size: 15px; color: var(--ink-2); }
  .cases { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(12px, 1.6vw, 20px); }
  .case { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .case__img { margin: -16px -16px 6px; overflow: hidden; border-radius: var(--radius) var(--radius) 0 0; }
  .case__img :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .case__role { font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0; line-height: 1.4; }
  .case h3 { font-size: 18px; margin: 0; }
  .case__lead { display: none; }
  .case p:not(.case__role):not(.case__lead) { color: var(--ink-2); font-size: 14px; line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .case .link-arrow { align-self: flex-start; font-size: 13px; margin-top: auto; padding-top: 8px; }
  @media (max-width: 1000px) { .cases { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .cases { grid-template-columns: 1fr; } }

  .phead { padding-block: clamp(56px, 8vw, 112px) clamp(48px, 6vw, 88px); }
  .phead__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(40px, 6vw, 96px); align-items: end; }
  .phead h1 { font-size: clamp(30px, 3.2vw, 46px); max-width: 20ch; }
  .phead .lede { margin: 24px 0 32px; }
  .proof { margin: 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .proof__item { padding: 22px 16px 22px 0; border-bottom: 1px solid var(--line); }
  .proof__item:nth-child(even) { padding-left: 20px; border-left: 1px solid var(--line); }
  .proof dt { font-size: clamp(28px, 2.6vw, 38px); line-height: 1; margin-bottom: 8px; }
  .proof dd { margin: 0; font-size: 14px; color: var(--muted); }

  .sec-h { font-size: clamp(28px, 3vw, 42px); margin-bottom: clamp(28px, 3vw, 44px); }

  .aud-group + .aud-group { margin-top: 40px; }
  .aud-group__label { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin: 0 0 16px; }
  .aud { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: clamp(20px, 2.5vw, 32px); }
  .aud__item { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px 24px; display: flex; flex-direction: column; gap: 14px; }
  .aud__item h3 { font-size: 23px; }
  .aud__item p { margin: 0; color: var(--ink-2); font-size: 15.5px; flex: 1; }
  .aud__item .link-arrow { align-self: flex-start; font-size: 14px; }

  .reasons { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 clamp(24px, 3vw, 48px); }
  .reason { padding: 28px 0 36px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; }
  .reason__num { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; color: var(--accent); }
  .reason h3 { font-size: 21px; }
  .reason > p { margin: 0; color: var(--ink-2); font-size: 15.5px; }
  .reason__proof { margin: 4px 0 0 !important; padding: 12px 14px; background: var(--paper-2); border-left: 2px solid var(--accent); font-size: 14px !important; }
  .reason__proof span { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .reason__proof a { text-decoration: none; }
  .reason__proof a:hover { color: var(--accent); text-decoration: underline; }

  .track__head { margin-bottom: 36px; }
  .track__head .eyebrow { margin-bottom: 10px; }
  .track__head h2 { max-width: 22ch; font-size: clamp(28px, 3vw, 42px); }
  .track__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .tp { display: block; text-decoration: none; color: inherit; }
  .tp :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); margin-bottom: 12px; transition: opacity 0.2s; }
  .tp:hover :global(img) { opacity: 0.85; }
  .tp__ph { display: flex; align-items: flex-end; aspect-ratio: 4 / 3; padding: 14px; margin-bottom: 12px; border-radius: var(--radius); background: linear-gradient(160deg, #2b3a44, #0f0f0e); color: rgba(246, 244, 239, 0.7); font-size: 13px; font-weight: 600; }
  .pill--client-dark { background: rgba(246, 244, 239, 0.14); color: var(--paper); }
  .pill--client-dark::before { display: none; }
  .tp__body { display: grid; gap: 4px; justify-items: start; padding-left: 12px; border-left: 3px solid var(--brand); }
  .tp strong { font-size: 17px; font-weight: 600; }
  .tp em { font-style: normal; font-size: 13px; color: rgba(246, 244, 239, 0.65); }
  .tp .pill { margin-top: 6px; font-size: 10.5px; padding: 4px 10px; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); }
  .criteria { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .criteria li { padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 17px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .steps li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; padding: 16px 0; border-top: 1px solid var(--line); }
  .steps li:last-child { border-bottom: 1px solid var(--line); }
  .steps__num { width: 34px; height: 34px; border-radius: 3px; border: 1px solid var(--ink); display: grid; place-items: center; font-weight: 600; font-size: 14px; }
  .steps h3 { font-size: 18px; margin-bottom: 4px; }
  .steps p { margin: 0; color: var(--muted); font-size: 15px; }

  .formwrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  .formwrap h2 { margin-bottom: 20px; }
  .pform { display: grid; gap: 18px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(24px, 3.5vw, 44px); }
  .pform .btn { justify-self: start; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .opt { font-weight: 400; color: var(--muted); }

  @media (max-width: 1100px) { .track__list { grid-template-columns: repeat(2, 1fr); } .reasons { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 860px) { .phead__grid, .split, .formwrap { grid-template-columns: 1fr; } }
  @media (max-width: 600px) {
    .reasons, .row { grid-template-columns: 1fr; }
    .track__list { grid-template-columns: 1fr 1fr; gap: 16px; }
  }

  .worked__intro { margin: -12px 0 40px; }
  .logos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .logos__item { min-height: 112px; display: grid; place-items: center; padding: 20px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: center; background: var(--white); }
  .logos__item img { max-width: 150px; max-height: 48px; width: auto; height: auto; object-fit: contain; filter: brightness(0); opacity: .72; }
  .logo--keep { filter: grayscale(1) !important; opacity: .85 !important; }
  .logos__word { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink-2); line-height: 1.25; }
  @media (max-width: 1000px) { .logos { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) { .logos { grid-template-columns: repeat(2, 1fr); } .logos__item { min-height: 88px; } }
  .proof__logo { display: block; height: clamp(40px, 4vw, 56px); width: auto; margin-bottom: 4px; }
  .trades__note { margin: 40px 0 0; font-size: 15px; color: var(--muted); max-width: 60ch; }
  .trades { margin-top: 24px; }
  .trades + .trades { margin-top: 28px; }
  .trades__label { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin: 0 0 14px; }
  .trades__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .trades__list li { padding: 8px 14px; border: 1px solid var(--line); background: var(--white); font-size: 14px; font-weight: 600; color: var(--ink-2); border-radius: 2px; }
