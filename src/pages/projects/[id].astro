---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import NewsCard from '../../components/NewsCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SocialFeed from '../../components/SocialFeed.astro';
import { getProjects, getNews, stageTone, STAGE_ORDER, formatMilestoneDate, brandInk, brandFill, isClientWork } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.hidden);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const images = [...(p.heroImage ? [{ image: p.heroImage, caption: '' }] : []), ...p.gallery];
const client = isClientWork(project);
const related = (await getNews()).filter((n) => n.data.project === project.id || n.data.projects?.includes(project.id)).slice(0, 3);
const all = await getProjects();
const idx = all.findIndex((x) => x.id === project.id);
const next = all[(idx + 1) % all.length];
const stageIdx = p.stage ? STAGE_ORDER.indexOf(p.stage) : -1;
const brand = brandInk(project);
const mon = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-CA', { month: 'short', year: 'numeric' });
const fmtRange = (a: string, b: string) => (a === b || mon(a) === mon(b) ? mon(a) : `${mon(a)} – ${mon(b)}`);
const fill = brandFill(project);
// Headline stats shown in the banner's brand-coloured band
const stats = [
  p.units ? { v: p.units.toLocaleString(), k: client ? 'Homes' : p.type?.toLowerCase().includes('rental') ? 'Rental homes' : 'Homes' } : null,
  p.storeys ? { v: String(p.storeys), k: 'Storeys' } : null,
  { v: p.type, k: 'Product' },
  client ? (p.years ? { v: p.years, k: 'Years' } : null) : p.operating ? { v: 'Owned and operated by LCH', k: 'Status' } : (p.stage ? { v: p.stage, k: 'Status' } : null),
  client ? (p.client ? { v: p.client, k: 'Client' } : null) : (p.partners.length ? { v: p.partners.join(', '), k: p.partners.length > 1 ? 'Partners' : 'Partner' } : null),
  !p.storeys && p.neighbourhood ? { v: p.neighbourhood, k: 'Neighbourhood' } : null,
].filter(Boolean).slice(0, 5) as { v: string; k: string }[];
const isExternal = (u?: string | null) => !!u && /^https?:/.test(u);

const facts = [
  ['Assignment', client ? 'Selected client work' : ''],
  ['Role', p.roleLabel ?? ''],
  ['Client', p.client ?? ''],
  ['Years', p.years ?? ''],
  ['Construction', p.stage ?? ''],
  ['Estimated delivery', p.delivery ?? ''],
  ['Operation', p.operating ? 'Owned and operated by LCH' : ''],
  ['Leasing', p.leasing?.status ?? ''],
  ['Product', p.type],
  ['Address', p.address],
  ['Neighbourhood', p.neighbourhood],
  ['Homes', p.units ? p.units.toLocaleString() : ''],
  ['Storeys', p.storeys ? String(p.storeys) : ''],
  ['Partners', p.partners.join(', ')],
  ['Architect', p.architect ?? ''],
].filter(([, v]) => v);
---

<Base overlay={!!p.heroImage} title={p.title} description={p.summary} image={p.heroImage ?? undefined}>
<div class="brand-scope" style={`--accent: ${brand}`}>
  <section class:list={['phead on-image', { 'phead--plain': !p.heroImage }]} style={`--brand: ${fill}; --brand-ink: ${brand}`}>
    {p.heroImage && <Img src={p.heroImage} alt="" loading="eager" fetchpriority="high" class="phead__bg" />}
    <div class="container phead__content">
      <a class="back" href="/projects/">← All projects</a>
      <span class="phead__pills">{client && <span class="pill pill--client-light">Selected client work{p.roleLabel ? ` · ${p.roleLabel}` : ''}</span>}{p.stage && <span class="pill" data-tone={stageTone(p.stage)}>{p.stage}</span>}{p.leasing?.status && <span class="pill pill--leasing">{p.leasing.status}</span>}</span>
      {p.logo?.endsWith('.svg')
        ? <h1 class="phead__brand"><img src={p.logo} alt={p.title} /></h1>
        : <h1>{p.title}</h1>}
      <p class="phead__loc">{[p.address, p.neighbourhood].filter(Boolean).join(' · ')}</p>
    </div>
  </section>
  {stats.length > 0 && (
    <section class="pstats" style={`--brand-ink: ${brand}`} aria-label={`${p.title} at a glance`}>
      <dl class="container pstats__row">
        {stats.map((st) => <div class="pstats__item"><dt>{st.k}</dt><dd class:list={{ 'pstats__num': /^[\d,]+$/.test(st.v) }}>{st.v}</dd></div>)}
        {p.leasing?.url && <a class="pstats__cta" href={p.leasing.url} target="_blank" rel="noopener">{p.leasing.status || 'Leasing'} ↗</a>}
        {p.construction?.url && <a class="pstats__cta" href={p.construction.url} target="_blank" rel="noopener">{p.construction.label || 'Construction updates'} ↗</a>}
      </dl>
    </section>
  )}

  <section class="section">
    <div class="container pbody">
      <div class="pbody__main">
        <p class="pbody__summary display">{p.summary}</p>
        <div class="prose"><Content /></div>
        {p.approach && (
          <div class="approach">
            <h2 class="approach__h">LCH’s role and approach</h2>
            <p>{p.approach}</p>
          </div>
        )}
        {p.website?.url && (
          <a class="btn" href={p.website.url} target="_blank" rel="noopener">{p.website.label || 'Visit project website'} <span class="arrow" aria-hidden="true">↗</span></a>
        )}
      </div>
      <aside class="pbody__facts" aria-label="Project facts">
        <dl>
          {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        {p.leasing?.status && p.leasing?.url ? (
          <div class="leasebox">
            <p class="leasebox__status">{p.leasing.status}</p>
            <p>{p.leasing.label || 'Leasing details'} are on the {p.title} website.</p>
            <a class="btn btn--lease" href={p.leasing.url} target="_blank" rel="noopener">Visit {p.leasing.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')} <span class="arrow" aria-hidden="true">↗</span></a>
          </div>
        ) : (
          <a class="btn btn--ghost" href={client ? '/partnerships/#partner-form' : '/contact/'}>{client ? 'Discuss a project' : `Enquire about ${p.title}`}</a>
        )}
      </aside>
    </div>
  </section>

  {(p.stage || p.milestones.length > 0) && (
  <section class="section--tight progress" aria-labelledby="progress-h">
    <div class="container">
      <div class="progress__grid">
        <div>
          <p class="eyebrow">Progress</p>
          <h2 id="progress-h">Construction status</h2>
          <ol class="stages" aria-label="Construction stage">
            {STAGE_ORDER.map((st, i) => (
              <li class:list={['stages__item', { 'is-done': i < stageIdx, 'is-current': i === stageIdx }]} aria-current={i === stageIdx ? 'step' : undefined}>
                <span class="stages__dot" aria-hidden="true"></span>
                {st === 'Under Construction' && p.schedule.length > 0 ? (
                  <details class="sched" open={i === stageIdx}>
                    <summary>{st} <span class="sched__hint">Construction milestones</span></summary>
                    <ol class="sched__list">
                      {p.schedule.map((m) => (
                        <li data-start={m.start} data-end={m.end}>
                          <span class="sched__name">{m.name}</span>
                          <span class="sched__date">{fmtRange(m.start, m.end)}</span>
                        </li>
                      ))}
                    </ol>
                    <p class="sched__note">Target dates from the construction schedule; they may change.{p.construction?.url && <> <a href={p.construction.url} target="_blank" rel="noopener">Latest updates ↗</a></>}</p>
                  </details>
                ) : <span>{st}</span>}
              </li>
            ))}
          </ol>
          {p.leasing?.status && <p class="progress__note">Leasing is tracked separately: <strong>{p.leasing.status}</strong>.</p>}
          {p.construction?.url && <a class="btn btn--ghost progress__cta" href={p.construction.url} target="_blank" rel="noopener">Schedule, site photos and email updates <span class="arrow" aria-hidden="true">↗</span></a>}
        </div>
        <div>
          {p.milestones.length > 0 ? (
            <ol class="timeline">
              {p.milestones.slice().reverse().map((m, i) => (
                <li class:list={['timeline__item', { 'is-latest': i === 0 }]}>
                  <time datetime={m.date}>{formatMilestoneDate(m.date)}</time>
                  <div>
                    {i === 0 && <span class="timeline__latest">Latest</span>}
                    <p>{m.label}</p>
                    {m.source && (m.sourceUrl
                      ? <a href={m.sourceUrl} target={isExternal(m.sourceUrl) ? '_blank' : undefined} rel="noopener">Source: {m.source}{isExternal(m.sourceUrl) ? ' ↗' : ''}</a>
                      : <span class="timeline__src">Source: {m.source}</span>)}
                  </div>
                </li>
              ))}
            </ol>
          ) : (
            <p class="timeline__empty">Dated updates will appear here as the project moves forward. For the latest, see <a href="/news/">News & Media</a>.</p>
          )}
        </div>
      </div>
    </div>
  </section>

  )}

  {images.length > 1 && (
    <section class="section--tight gallery-wrap">
      <div class="container">
        <p class="eyebrow">Gallery</p>
        <div class="gallery">
          {images.map((g, i) => (
            <button class="gallery__item reveal" data-index={i} aria-label={`Open image ${i + 1} of ${images.length}`}>
              <Img src={g.image} alt={g.caption || `${p.title} image ${i + 1}`} sizes="(max-width: 760px) 100vw, 50vw" />
            </button>
          ))}
        </div>
      </div>
      <dialog class="lightbox" data-lightbox aria-label="Image viewer">
        <button class="lightbox__close" data-close aria-label="Close">×</button>
        <button class="lightbox__nav lightbox__prev" data-prev aria-label="Previous image">←</button>
        <figure>
          <img data-full alt="" />
          <figcaption data-caption></figcaption>
        </figure>
        <button class="lightbox__nav lightbox__next" data-next aria-label="Next image">→</button>
      </dialog>
      <script is:inline type="application/json" data-images set:html={JSON.stringify(images.map((g) => ({ src: g.image, caption: g.caption || '' })))} />
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">In the news</p>
        <h2 class="related-h">{p.title} updates</h2>
        <div class="grid-3">{related.map((n) => <NewsCard post={n} />)}</div>
      </div>
    </section>
  )}

  <SocialFeed project={project.id} count={6} showFollow={false} eyebrow="On our channels" heading={`${p.title} on social`} />

  {next && next.id !== project.id && (
    <section class="section section--alt">
      <div class="container next">
        <div>
          <p class="eyebrow">Next project</p>
          <h2>{next.data.title}</h2>
          <p class="lede">{next.data.summary}</p>
          <a class="btn" href={`/projects/${next.id}/`}>View {next.data.title} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ProjectCard project={next} sizes="(max-width: 900px) 100vw, 50vw" />
      </div>
    </section>
  )}
</div>
</Base>

<script>
  // Mark each scheduled phase as done / in progress / upcoming against today's date
  const today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('.sched__list li').forEach((li) => {
    const { start = '', end = '' } = li.dataset;
    li.classList.add(end < today ? 'is-done' : start <= today ? 'is-now' : 'is-next');
  });
</script>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dlg) {
    const data: { src: string; caption: string }[] = JSON.parse(document.querySelector('[data-images]')!.textContent!);
    const img = dlg.querySelector<HTMLImageElement>('[data-full]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-caption]')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + data.length) % data.length;
      img.src = data[i].src;
      img.alt = data[i].caption;
      cap.textContent = data[i].caption ? data[i].caption : `${i + 1} / ${data.length}`;
    };
    document.querySelectorAll<HTMLElement>('[data-index]').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.index)); dlg.showModal(); }),
    );
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
  }
</script>

<script>
  // Header photo parallax: drifts at about a third of the scroll speed. Off for reduced-motion visitors.
  const bg = document.querySelector<HTMLElement>('.phead__bg');
  const head = document.querySelector<HTMLElement>('.phead');
  if (bg && head && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    bg.classList.add('is-parallax');
    let ticking = false;
    const update = () => {
      ticking = false;
      const h = head.offsetHeight;
      const y = Math.min(window.scrollY, h);
      bg.style.transform = `translate3d(0, ${(y * 0.32).toFixed(1)}px, 0)`;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>

<style>
  .phead { position: relative; overflow: hidden; height: calc(82svh - var(--announce-h)); min-height: 480px; display: flex; align-items: flex-end; color: var(--paper); isolation: isolate; padding-block: calc(var(--header-h) + 64px) clamp(48px, 7vw, 88px); }
  .phead::after { content: ''; position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(180deg, rgba(10, 10, 9, 0.45), rgba(10, 10, 9, 0) 30%),
    linear-gradient(0deg, color-mix(in srgb, var(--brand-ink) 92%, transparent) 0%, color-mix(in srgb, var(--brand-ink) 45%, transparent) 38%, transparent 70%),
    linear-gradient(90deg, color-mix(in srgb, var(--brand-ink) 35%, transparent), transparent 60%); }
  .phead__brand { margin: 4px 0 0; line-height: 0; }
  .phead__brand img { display: block; height: clamp(56px, 8vw, 104px); width: auto; max-width: min(440px, 80vw); object-fit: contain; object-position: left center; filter: brightness(0) invert(1); }
  .pstats { background: var(--brand-ink); color: #fff; }
  .pstats__row { display: flex; flex-wrap: wrap; align-items: stretch; margin-block: 0; padding-block: 0; }
  .pstats__item { flex: 1 1 0; min-width: 150px; padding: 22px 24px 24px 0; margin-right: 24px; border-right: 1px solid rgba(255, 255, 255, 0.18); }
  .pstats__item:last-of-type { border-right: 0; }
  .pstats dt { font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); margin-bottom: 6px; }
  .pstats dd { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.3; }
  .pstats dd.pstats__num { font-size: clamp(28px, 3vw, 40px); font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  .pstats__cta + .pstats__cta { margin-left: 10px; }
  .progress__cta { margin-top: 20px; }
  .pstats__cta { align-self: center; margin-left: auto; padding: 12px 18px; border: 1px solid rgba(255, 255, 255, 0.6); border-radius: 3px; color: #fff; text-decoration: none; font-weight: 600; font-size: 14px; white-space: nowrap; }
  .pstats__cta:hover { background: #fff; color: var(--brand-ink); }
  @media (max-width: 760px) {
    .pstats__row { display: grid; grid-template-columns: 1fr 1fr; }
    .pstats__item { margin-right: 0; padding: 18px 12px 18px 0; border-right: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.18); }
    .pstats__cta { grid-column: 1 / -1; margin: 16px 0; text-align: center; }
  }
  :global(.phead__bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  /* Parallax: the photo is taller than the header and drifts slower than the page as you scroll */
  :global(.phead__bg.is-parallax) { top: -12%; height: 124%; will-change: transform; }
  .phead__content { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .phead h1 { font-size: clamp(40px, 5.4vw, 76px); line-height: 1; }
  .phead__loc { font-size: 18px; color: rgba(246, 244, 239, 0.85); margin: 0; }
  .back { font-size: 14px; text-decoration: none; color: rgba(246, 244, 239, 0.8); margin-bottom: 12px; }
  .back:hover { color: #fff; }

  .pbody { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(40px, 7vw, 112px); align-items: start; }
  .pbody__logo { height: 40px; width: auto; max-width: 200px; object-fit: contain; object-position: left; margin-bottom: 32px; }
  .pbody__summary { font-size: clamp(22px, 2vw, 30px); font-weight: 500; letter-spacing: -0.02em; line-height: 1.25; margin-bottom: 28px; }
  .pbody .prose { font-size: 18px; margin-bottom: 32px; }
  .pbody__facts { position: sticky; top: calc(var(--header-h) + 24px); background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
  .pbody__facts dl { margin: 0 0 24px; }
  .pbody__facts dl > div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .pbody__facts dl > div:first-child { padding-top: 0; }
  .pbody__facts dt { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); padding-top: 3px; }
  .pbody__facts dd { margin: 0; font-size: 15px; }
  .pbody__facts .btn { width: 100%; }

  .gallery { columns: 2; column-gap: 16px; }
  .gallery__item { display: block; width: 100%; padding: 0; margin: 0 0 16px; border: 0; background: var(--paper-2); cursor: zoom-in; overflow: hidden; border-radius: var(--radius); break-inside: avoid; }
  .gallery__item :global(img) { width: 100%; height: auto; transition: transform 1s var(--ease); }
  .gallery__item:hover :global(img) { transform: scale(1.03); }

  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(10, 10, 9, 0.95); color: #fff; }
  .lightbox[open] { display: grid; grid-template-columns: 72px 1fr 72px; align-items: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox figure { margin: 0; display: grid; gap: 12px; justify-items: center; padding: 56px 0; height: 100%; align-content: center; }
  .lightbox img { max-height: calc(100dvh - 140px); width: auto; max-width: 100%; object-fit: contain; }
  .lightbox figcaption { font-size: 14px; color: rgba(255, 255, 255, 0.7); }
  .lightbox button { background: transparent; border: 0; color: #fff; cursor: pointer; font-size: 28px; height: 56px; }
  .lightbox__close { position: absolute; top: 12px; right: 16px; font-size: 40px !important; z-index: 2; }

  .related-h { margin-bottom: 40px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 3vw, 44px); }

  .next { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .next h2 { margin-bottom: 16px; }
  .next .lede { margin-bottom: 28px; }
  .next :global(.pcard__body) { display: none; }

  @media (max-width: 900px) {
    .pbody, .next { grid-template-columns: 1fr; }
    .pbody__facts { position: static; }
    .grid-3 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .gallery { columns: 1; }
    .grid-3 { grid-template-columns: 1fr; }
    .lightbox[open] { grid-template-columns: 44px 1fr 44px; }
  }

  .phead__pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .leasebox { display: grid; gap: 10px; padding: 18px; border-radius: var(--radius); background: color-mix(in srgb, var(--accent) 8%, #fff); border: 1px solid color-mix(in srgb, var(--accent) 25%, #fff); }
  .leasebox p { margin: 0; font-size: 15px; color: var(--ink-2); }
  .leasebox__status { font-size: 12px !important; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent) !important; }
  .btn--lease { --bg: var(--accent); --fg: #fff; width: 100%; }
  .btn--lease:hover { filter: brightness(1.15); }

  .progress { border-top: 1px solid var(--line); }
  .progress__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .progress h2 { margin-bottom: 28px; }
  .stages { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .stages__item { position: relative; display: flex; align-items: center; gap: 14px; padding: 10px 0; color: var(--muted); font-weight: 500; }
  .stages__item:not(:last-child)::after { content: ''; position: absolute; left: 7px; top: 30px; bottom: -10px; width: 2px; background: var(--line); }
  .stages__dot { width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--line); background: var(--paper); flex: none; position: relative; z-index: 1; }
  .stages__item.is-done { color: var(--ink-2); }
  .stages__item.is-done .stages__dot { background: var(--ink); border-color: var(--ink); }
  .stages__item.is-done::after { background: var(--ink) !important; }
  .stages__item.is-current { color: var(--ink); font-weight: 700; }
  .stages__item:has(.sched) { align-items: flex-start; }
  .stages__item:has(.sched) .stages__dot { margin-top: 3px; }
  .sched { flex: 1; }
  .sched summary { cursor: pointer; list-style: none; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .sched summary::-webkit-details-marker { display: none; }
  .sched summary::after { content: '▾'; font-size: 13px; color: var(--muted); transition: transform .2s; }
  .sched[open] summary::after { transform: rotate(180deg); }
  .sched__hint { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .sched__list { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 0; border-left: 2px solid var(--line); }
