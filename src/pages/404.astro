---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found">
  <PageHero eyebrow="404" heading="This page has moved — or never existed." lede="Our site has a new look. Try one of these instead.">
    <p style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
      <a class="btn" href="/">Home</a>
      <a class="btn btn--ghost" href="/projects/">Projects</a>
      <a class="btn btn--ghost" href="/news/">News</a>
    </p>
  </PageHero>
</Base>
