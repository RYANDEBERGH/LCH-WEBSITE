---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { render } from 'astro:content';
import { settings, story, home, getTeam, getProjects, md, brandInk } from '../lib/site';

const team = await Promise.all((await getTeam()).map(async (t) => ({ ...t, Content: (await render(t)).Content })));
const projectsById = Object.fromEntries((await getProjects()).map((p) => [p.id, p]));
const e = home.elevate;
---

<Base title="About Us" description="LCH Developments: development, development management and, through affiliated Elevate, construction management. Our history, expertise and team.">
  <section class="ahead">
    <div class="container ahead__grid">
      <div>
        <p class="eyebrow">{story.hero.eyebrow}</p>
        <h1>{story.hero.heading}</h1>
        <div class="ahead__body" set:html={md(story.overview.body)} />
      </div>
      <figure class="ahead__photo">
        <Img src={story.overview.image} alt={story.overview.imageAlt} sizes="(max-width: 900px) 100vw, 45vw" loading="eager" />
      </figure>
    </div>
    <div class="container">
      <ul class="values">
        {story.values.map((v) => (
          <li><h3>{v.title}</h3><p>{v.body}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section history" id="history">
    <div class="container">
      <p class="eyebrow">{story.timelineHeading.eyebrow}</p>
      <h2 class="sec-h">{story.timelineHeading.heading}</h2>
      <div class="tl" data-tl>
        <div class="tl__controls" aria-label="Scroll the timeline">
          <button type="button" class="tl__btn" data-tl-prev aria-label="Earlier">←</button>
          <button type="button" class="tl__btn" data-tl-next aria-label="Later">→</button>
        </div>
        <ol class="tl__track" data-tl-track tabindex="0" aria-label="Company timeline, scroll sideways">
          {story.timeline.map((c) => {
            const im = c.images[0];
            return (
              <li class="tl__card">
                <p class="tl__label">{c.label}</p>
                <div class="tl__media">
                  {im ? (
                    <figure>
                      <Img src={im.image} alt={im.alt} sizes="340px" />
                      {im.caption && <figcaption>{im.caption}</figcaption>}
                      {c.images.length > 1 && <span class="tl__more">+{c.images.length - 1}</span>}
                    </figure>
                  ) : <div class:list={["tl__noimg", { "tl__noimg--long": c.label.length > 8 }]} aria-hidden="true"><span>{c.label}</span></div>}
                </div>
                <h3>{c.title}</h3>
                <p class="tl__text">{c.text}</p>
                {c.projects.length > 0 && (
                  <p class="tl__links">
                    {c.projects.map((id) => projectsById[id]).filter(Boolean).map((p) => (
                      <a href={`/projects/${p.id}/`} style={`--brand: ${brandInk(p)}`}>{p.data.title}</a>
                    ))}
                  </p>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="expertise">
    <div class="container">
      <p class="eyebrow">{story.expertise.eyebrow}</p>
      <h2 class="sec-h">{story.expertise.heading}</h2>
      <div class="expertise">
        {story.expertise.items.map((x, i) => (
          <article class="xp reveal">
            <span class="xp__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{x.title}</h3>
            <p>{x.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark" id="lch-elevate">
    <div class="container">
      <div class="le__top">
        <div>
          <a class="le__logo" href={settings.elevate.url} target="_blank" rel="noopener" aria-label="Elevate Construction Management website"><img src={settings.elevate.logoLight} alt="Elevate Construction Management" width="200" height="98" loading="lazy" /></a>
          <p class="eyebrow">{e.eyebrow}</p>
          <h2>{e.heading}</h2>
          <div class="le__body" set:html={md(e.body)} />
          <a class="btn btn--ghost-light" href={e.extUrl} target="_blank" rel="noopener">{e.extLabel} <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
        <figure class="le__photo"><Img src={e.image} alt={e.imageAlt} sizes="(max-width: 900px) 100vw, 45vw" /></figure>
      </div>
      <div class="le__roles">
        <div><p class="le__who">LCH leads</p><ul>{e.lch.map((x) => <li>{x}</li>)}</ul></div>
        <div><p class="le__who">Elevate leads</p><ul>{e.elevateList.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <p class="eyebrow">{story.experience.eyebrow}</p>
      <h2 class="sec-h">{story.experience.heading}</h2>
      <div class="cases">
        {story.experience.items.map((c) => (
          <article class="case reveal">
            {c.image && <div class="case__img"><Img src={c.image} alt={c.imageAlt ?? ''} sizes="(max-width: 680px) 100vw, 33vw" /></div>}
            <p class="case__role">Selected client work · {c.role}</p>
            <h3>{c.title}</h3>
            <p class="case__lead">{c.heading}</p>
            <p>{c.body}</p>
            {c.project && <a class="link-arrow" href={`/projects/${c.project}/`}>View {c.title} →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="team">
    <div class="container">
      <p class="eyebrow">{story.team.eyebrow}</p>
      <h2 class="sec-h">{story.team.heading}</h2>
      <div class="team-filters" role="group" aria-label="Filter the team">
        <button type="button" class="tchip" aria-pressed="true" data-team-filter="all">All <span>{team.length}</span></button>
        <button type="button" class="tchip" aria-pressed="false" data-team-filter="lch">LCH Developments <span>{team.filter((t) => t.data.companies.includes('lch')).length}</span></button>
        <button type="button" class="tchip" aria-pressed="false" data-team-filter="elevate">Elevate <span>{team.filter((t) => t.data.companies.includes('elevate')).length}</span></button>
      </div>
      <div class="team">
        {team.map((t) => (
          <article class="member reveal" data-companies={t.data.companies.join(" ")}>
            <button class="member__btn" data-member={t.id} aria-haspopup="dialog">
              <div class="member__photo">
                {t.data.photo && <Img src={t.data.photo} alt={t.data.name} sizes="(max-width: 600px) 50vw, 25vw" />}
              </div>
              <h3>{t.data.name}{t.data.credentials && <span class="member__cred">, {t.data.credentials}</span>}</h3>
              <p class="member__role">{t.data.role}</p>
              <p class="member__cos">{t.data.companies.map((c) => <span class={`member__co member__co--${c}`}>{c === 'lch' ? 'LCH' : 'Elevate'}</span>)}</p>
              <span class="member__more">Read bio +</span>
            </button>
            <dialog class="bio" id={`bio-${t.id}`} aria-label={`${t.data.name} biography`}>
              <button class="bio__close" data-close aria-label="Close">×</button>
              <div class="bio__grid">
                {t.data.photo && <Img src={t.data.photo} alt={t.data.name} sizes="300px" class="bio__photo" />}
                <div>
                  <p class="eyebrow">{t.data.role}</p>
                  <h2>{t.data.name}</h2>
                  {t.data.credentials && <p class="member__cred">{t.data.credentials}</p>}
                  <div class="prose"><t.Content /></div>
                  {t.data.linkedin && <a class="link-arrow" href={t.data.linkedin} target="_blank" rel="noopener">{t.data.name.split(' ')[0]} on LinkedIn ↗</a>}
                </div>
              </div>
            </dialog>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section acta">
    <div class="container acta__inner">
      <div>
        <h2>{story.cta.heading}</h2>
        <p class="lede">{story.cta.body}</p>
      </div>
      <div class="acta__btns">
        <a class="btn" href={story.cta.ctaUrl}>{story.cta.ctaLabel} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={story.cta.secondaryUrl}>{story.cta.secondaryLabel}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Team filter: All / LCH Developments / Elevate
  const tchips = document.querySelectorAll<HTMLButtonElement>('[data-team-filter]');
  tchips.forEach((chip) => chip.addEventListener('click', () => {
    const f = chip.dataset.teamFilter!;
    tchips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    document.querySelectorAll<HTMLElement>('.member[data-companies]').forEach((m) => {
      m.hidden = f !== 'all' && !(m.dataset.companies ?? '').split(' ').includes(f);
    });
  }));

  document.querySelectorAll<HTMLElement>('[data-tl]').forEach((tl) => {
    const track = tl.querySelector<HTMLElement>('[data-tl-track]')!;
    const prev = tl.querySelector<HTMLButtonElement>('[data-tl-prev]')!;
    const next = tl.querySelector<HTMLButtonElement>('[data-tl-next]')!;
    const step = () => (track.querySelector<HTMLElement>('.tl__card')?.offsetWidth ?? 300) + 20;
    const update = () => {
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();

    // On first view, slide from the beginning to the most recent chapter; visitors can then click or swipe back.
    let raf = 0, cancelled = false;
    const stop = () => { cancelled = true; cancelAnimationFrame(raf); track.classList.remove('is-sliding'); };
    ['pointerdown', 'wheel', 'touchstart', 'keydown'].forEach((ev) => track.addEventListener(ev, stop, { passive: true }));
    prev.addEventListener('click', stop);
    next.addEventListener('click', stop);
    const slideToEnd = () => {
      const end = track.scrollWidth - track.clientWidth;
      if (end <= 0 || cancelled) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { track.scrollLeft = end; return; }
      track.classList.add('is-sliding');
      const t0 = performance.now(), dur = Math.min(2600, 700 + end * 0.9);
      const tick = (now: number) => {
        if (cancelled) return;
        const t = Math.min(1, (now - t0) / dur);
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; // ease in-out
        track.scrollLeft = end * e;
        if (t < 1) raf = requestAnimationFrame(tick);
        else track.classList.remove('is-sliding');
      };
      raf = requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(slideToEnd, 350); }
    }, { threshold: 0.45 });
    io.observe(track);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-member]').forEach((b) => {
    const dlg = document.getElementById(`bio-${b.dataset.member}`) as HTMLDialogElement;
    b.addEventListener('click', () => dlg.showModal());
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>

<style>
  .ahead { padding-block: clamp(56px, 8vw, 112px) clamp(48px, 6vw, 80px); }
  .ahead__grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .ahead h1 { font-size: clamp(40px, 5.4vw, 76px); margin-bottom: 24px; max-width: 14ch; }
  .ahead__body :global(p) { font-size: 18px; color: var(--ink-2); }
  .ahead__photo { margin: 0; }
  .ahead__photo :global(img) { width: 100%; height: auto; border-radius: var(--radius); }
  .values { list-style: none; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); }
  .values li { border-top: 2px solid var(--ink); padding-top: 16px; }
  .values h3 { font-size: 19px; margin-bottom: 6px; }
  .values p { margin: 0; color: var(--muted); font-size: 15.5px; }

  .sec-h { margin-bottom: clamp(32px, 4vw, 56px); max-width: 22ch; }
  .history { border-top: 1px solid var(--line); }
  .history { border-top: 1px solid var(--line); }
  .tl { position: relative; }
  .tl__controls { position: absolute; right: 0; top: -76px; display: flex; gap: 8px; }
  .tl__btn { width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 3px; background: var(--white); color: var(--ink); font-size: 18px; cursor: pointer; }
  .tl__btn:hover:not(:disabled) { border-color: var(--ink); }
  .tl__btn:disabled { opacity: 0.35; cursor: default; }
  .tl__track { list-style: none; margin: 0; padding: 0 0 18px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, 320px); gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; overscroll-behavior-x: contain; scrollbar-width: thin; position: relative; }
  .tl__track.is-sliding { scroll-snap-type: none; scroll-behavior: auto; }
  .tl__track:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .tl__track::before { content: ''; position: absolute; left: 0; right: 0; top: 9px; height: 1px; background: var(--line); }
  .tl__card { scroll-snap-align: start; position: relative; display: flex; flex-direction: column; gap: 10px; padding-top: 30px; }
  .tl__card::before { content: ''; position: absolute; left: 0; top: 4px; width: 11px; height: 11px; background: var(--ink); border-radius: 2px; }
  .tl__label { position: absolute; left: 20px; top: 0; margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .tl__media figure { margin: 0; position: relative; }
  .tl__media :global(img), .tl__noimg { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); display: block; }
  .tl__noimg { display: flex; align-items: flex-end; padding: 18px; background: var(--paper-2); border: 1px solid var(--line); color: var(--ink); font-size: 44px; font-weight: 700; letter-spacing: -0.03em; }
  .tl__noimg--long { font-size: 28px; line-height: 1.1; }
  .tl__media figcaption, .tl__more { position: absolute; bottom: 8px; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; background: rgba(255, 255, 255, 0.92); color: var(--ink); padding: 3px 7px; border-radius: 2px; }
  .tl__media figcaption { left: 8px; }
  .tl__more { right: 8px; }
  .tl__card h3 { font-size: 19px; margin-top: 6px; }
  .tl__text { margin: 0; font-size: 15px; color: var(--ink-2); }
  .tl__links { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0; font-size: 13px; }
  .tl__links a { color: var(--brand); font-weight: 600; text-decoration: none; }
  .tl__links a:hover { text-decoration: underline; }
  .expertise { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 clamp(24px, 3vw, 48px); }
  .xp { padding: 24px 0 36px; border-top: 1px solid var(--line); }
  .xp__num { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; color: var(--accent); }
  .xp h3 { font-size: 20px; margin: 10px 0 10px; }
  .xp p { margin: 0; color: var(--ink-2); font-size: 15.5px; }

  .le__top { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .le__top h2 { margin-bottom: 20px; }
  .le__logo { display: block; width: fit-content; margin-bottom: 28px; }
  .le__logo img { height: 64px; width: auto; display: block; }
  .le__body :global(p) { color: rgba(246, 244, 239, 0.78); font-size: 17px; }
  .le__top .btn { margin-top: 12px; }
  .le__photo { margin: 0; }
  .le__photo :global(img) { width: 100%; height: auto; border-radius: var(--radius); }
  .le__roles { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); margin-top: clamp(40px, 5vw, 64px); }
  .le__roles > div { border-top: 1px solid rgba(246, 244, 239, 0.2); padding-top: 20px; }
  .le__who { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(246, 244, 239, 0.6); margin-bottom: 12px; }
  .le__roles ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .le__roles li { font-size: 17px; padding-left: 18px; position: relative; }
  .le__roles li::before { content: ''; position: absolute; left: 0; top: 10px; width: 6px; height: 6px; background: rgba(246, 244, 239, 0.6); }

  .cases { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.5vw, 32px); }
  .case { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px 26px; display: flex; flex-direction: column; gap: 10px; }
  .case__img { margin: -28px -26px 8px; overflow: hidden; border-radius: var(--radius) var(--radius) 0 0; }
  .case__img :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
  .case__role { font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 0; }
  .case h3 { font-size: 24px; }
  .case__lead { font-weight: 600; margin: 0; }
  .case p:not(.case__role):not(.case__lead) { color: var(--ink-2); font-size: 15.5px; margin: 0; flex: 1; }
  .case .link-arrow { align-self: flex-start; font-size: 14px; margin-top: 8px; }

  .acta { border-top: 1px solid var(--line); }
  .acta__inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px 48px; }
  .acta h2 { font-size: clamp(28px, 3vw, 42px); margin-bottom: 10px; }
  .acta .lede { margin: 0; }
  .acta__btns { display: flex; flex-wrap: wrap; gap: 10px; }

  .team-h { margin-bottom: 48px; }
  .team-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: -16px 0 36px; }
  .tchip { min-height: 42px; padding: 0 16px; border-radius: 3px; border: 1px solid var(--line); background: transparent; color: var(--ink); font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
  .tchip span { font-size: 12px; font-weight: 500; color: var(--muted); }
  .tchip:hover { border-color: var(--ink); }
  .tchip[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .tchip[aria-pressed='true'] span { color: rgba(246, 244, 239, 0.6); }
  .member[hidden] { display: none; }
  .member__cos { display: flex; gap: 6px; margin: 0 0 10px; }
  .member__co { font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 7px; border-radius: 2px; border: 1px solid var(--line); color: var(--muted); }
  .member__co--elevate { color: #1f5c3c; border-color: rgba(31, 92, 60, 0.35); }
  .team { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px clamp(24px, 3vw, 40px); }
  .member__btn { all: unset; cursor: pointer; display: block; width: 100%; }
  .member__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .member__photo { aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius); background: var(--paper-2); margin-bottom: 18px; }
  .member__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; filter: grayscale(1); transition: filter 0.5s, transform 1s var(--ease); }
  .member__btn:hover .member__photo :global(img) { filter: grayscale(0); transform: scale(1.03); }
  .member h3 { font-size: 21px; }
  .member__cred { color: var(--muted); font-weight: 400; font-size: 0.85em; }
  .member__role { font-size: 15px; color: var(--muted); margin: 4px 0 10px; }
  .member__more { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  .bio { width: min(960px, calc(100vw - 32px)); max-height: calc(100dvh - 48px); border: 0; border-radius: 8px; padding: clamp(24px, 4vw, 56px); background: var(--paper); color: var(--ink); }
  .bio::backdrop { background: rgba(10, 10, 9, 0.6); backdrop-filter: blur(4px); }
  .bio__grid { display: grid; grid-template-columns: 260px 1fr; gap: 40px; align-items: start; }
  .bio__grid :global(.bio__photo) { border-radius: var(--radius); width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .bio h2 { font-size: clamp(30px, 3vw, 40px); margin-bottom: 8px; }
  .bio .eyebrow { margin-bottom: 12px; }
  .bio .prose { margin-top: 20px; font-size: 16px; }
  .bio__close { position: absolute; top: 12px; right: 16px; border: 0; background: none; font-size: 36px; cursor: pointer; color: var(--ink); line-height: 1; }

  @media (max-width: 1000px) { .team { grid-template-columns: repeat(2, 1fr); } .cases { grid-template-columns: 1fr 1fr; } .expertise { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) {
    .ahead__grid, .le__top { grid-template-columns: 1fr; }
    .tl__controls { position: static; justify-content: flex-end; margin-bottom: 12px; }
  }
  @media (max-width: 680px) {
    .values, .le__roles, .cases, .expertise { grid-template-columns: 1fr; }
    .team { grid-template-columns: repeat(2, 1fr); gap: 36px 16px; }
    .bio__grid { grid-template-columns: 1fr; }
    .bio__grid :global(.bio__photo) { max-width: 200px; }
  }
</style>
