---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { render } from 'astro:content';
import { settings, story, home, getTeam, getProjects, md, brandInk } from '../lib/site';

const team = await Promise.all((await getTeam()).map(async (t) => ({ ...t, Content: (await render(t)).Content })));
const projectsById = Object.fromEntries((await getProjects()).map((p) => [p.id, p]));
const e = home.elevate;
const L = story.lchElevate;
---

<Base title="About Us" description="LCH Developments: development, development management and, through affiliated Elevate, construction management. Our history, expertise and team.">
  <section class="ahead">
    <div class="container ahead__grid">
      <div>
        <p class="eyebrow">{story.hero.eyebrow}</p>
        <h1>{story.hero.heading}</h1>
        <div class="ahead__body" set:html={md(story.overview.body)} />
      </div>
      <figure class="ahead__photo">
        <Img src={story.overview.image} alt={story.overview.imageAlt} sizes="(max-width: 900px) 100vw, 45vw" loading="eager" />
      </figure>
    </div>
    <div class="container">
      <ul class="values">
        {story.values.map((v) => (
          <li><h3>{v.title}</h3><p>{v.body}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section history" id="history">
    <div class="container">
      <p class="eyebrow">{story.timelineHeading.eyebrow}</p>
      <h2 class="sec-h">{story.timelineHeading.heading}</h2>
      <div class="tl" data-tl>
        <div class="tl__controls" aria-label="Scroll the timeline">
          <button type="button" class="tl__btn" data-tl-prev aria-label="Earlier">←</button>
          <button type="button" class="tl__btn" data-tl-next aria-label="Later">→</button>
        </div>
        <ol class="tl__track" data-tl-track tabindex="0" aria-label="Company timeline, scroll sideways">
          {story.timeline.map((c) => {
            const im = c.images[0];
            return (
              <li class="tl__card">
                <p class="tl__label">{c.label}</p>
                <div class="tl__media">
                  {im ? (
                    <figure>
                      <Img src={im.image} alt={im.alt} sizes="340px" />
                      {im.caption && <figcaption>{im.caption}</figcaption>}
                      {c.images.length > 1 && <span class="tl__more">+{c.images.length - 1}</span>}
                    </figure>
                  ) : <div class:list={["tl__noimg", { "tl__noimg--long": c.label.length > 8 }]} aria-hidden="true"><span>{c.label}</span></div>}
                </div>
                <h3>{c.title}</h3>
                <p class="tl__text">{c.text}</p>
                {c.projects.length > 0 && (
                  <p class="tl__links">
                    {c.projects.map((id) => projectsById[id]).filter(Boolean).map((p) => (
                      <a href={`/projects/${p.id}/`} style={`--brand: ${brandInk(p)}`}>{p.data.title}</a>
                    ))}
                  </p>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="expertise">
    <div class="container">
      <p class="eyebrow">{story.expertise.eyebrow}</p>
      <h2 class="sec-h">{story.expertise.heading}</h2>
      <div class="expertise">
        {story.expertise.items.map((x, i) => (
          <article class="xp reveal">
            <span class="xp__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{x.title}</h3>
            <p>{x.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>


  <section class="section section--alt" id="team">
    <div class="container">
      <p class="eyebrow">{story.team.eyebrow}</p>
      <h2 class="sec-h">{story.team.heading}</h2>
      <div class="team-filters" role="group" aria-label="Filter the team">
        <button type="button" class="tchip" aria-pressed="true" data-team-filter="all">All</button>
        <button type="button" class="tchip" aria-pressed="false" data-team-filter="lch">LCH Developments</button>
        <button type="button" class="tchip" aria-pressed="false" data-team-filter="elevate">Elevate</button>
      </div>
      <div class="team">
        {team.map((t) => (
          <article class="member reveal" data-companies={t.data.companies.join(" ")}>
            <button class="member__btn" data-member={t.id} aria-haspopup="dialog">
              <div class="member__photo">
                {t.data.photo && <Img src={t.data.photo} alt={t.data.name} sizes="(max-width: 600px) 50vw, 25vw" />}
              </div>
              <h3>{t.data.name}{t.data.credentials && <span class="member__cred">{t.data.credentials}</span>}</h3>
              <p class="member__role">{t.data.role}</p>
              <p class="member__cos">{t.data.companies.map((c) => <span class={`member__co member__co--${c}`}>{c === 'lch' ? 'LCH' : 'Elevate'}</span>)}</p>
              <span class="member__more">Read bio +</span>
            </button>
            <dialog class="bio" id={`bio-${t.id}`} aria-label={`${t.data.name} biography`}>
              <button class="bio__close" data-close aria-label="Close">×</button>
              <div class="bio__grid">
                {t.data.photo && <Img src={t.data.photo} alt={t.data.name} sizes="300px" class="bio__photo" />}
                <div>
                  <p class="eyebrow">{t.data.role}</p>
                  <h2>{t.data.name}</h2>
                  {t.data.credentials && <p class="member__cred">{t.data.credentials}</p>}
                  <div class="prose"><t.Content /></div>
                  {t.data.linkedin && <a class="link-arrow" href={t.data.linkedin} target="_blank" rel="noopener">{t.data.name.split(' ')[0]} on LinkedIn ↗</a>}
                </div>
              </div>
            </dialog>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark le2" id="lch-elevate">
    <div class="container">
      <div class="le2__head">
        <div>
          <p class="eyebrow">{L.eyebrow}</p>
          <h2>{L.heading}</h2>
        </div>
        <p class="le2__intro">{L.intro}</p>
      </div>

      <div class="le2__cos">
        {L.companies.map((c) => {
          const people = team.filter((t) => t.data.companies.includes(c.key));
          const leaders = (c.leaders ?? []).map((id) => team.find((t) => t.id === id)).filter(Boolean);
          const ext = c.cta?.url?.startsWith('http');
          return (
            <article class:list={['le2__co reveal', `le2__co--${c.key}`]}>
              <div class="le2__img">
                <Img src={c.image} alt={c.imageAlt} sizes="(max-width: 900px) 100vw, 50vw" />
                <div class="le2__badge"><img src={c.key === 'lch' ? settings.logo : settings.elevate.logo} alt={c.name} loading="lazy" /></div>
              </div>
              <div class="le2__cobody">
                <p class="le2__tag">{c.tagline}</p>
                <h3>{c.name}</h3>
                {c.values && <p class="le2__values">{c.values.map((v) => <span>{v}</span>)}</p>}
                <p class="le2__desc">{c.body}</p>
                <div class="le2__foot">
                  <div class="le2__people">
                  <div class="le2__leaders">
                    <span class="le2__faces">{leaders.map((t) => t!.data.photo && <button type="button" class="le2__face" data-member={t!.id} aria-haspopup="dialog" title={`Read ${t!.data.name}'s bio`}><Img src={t!.data.photo} alt={t!.data.name} sizes="48px" /></button>)}</span>
                    <span><strong>{leaders.map((t, i) => <>{i > 0 && ' & '}<button type="button" class="le2__name" data-member={t!.id} aria-haspopup="dialog">{t!.data.name}</button></>)}</strong><em>{leaders[0]?.data.role.replace(/, Elevate.*$/, '')}{leaders.length > 1 ? 's' : ''}</em></span>
                  </div>
                    {(c.partners ?? []).length > 0 && (() => {
                      const ps = c.partners.map((id) => team.find((t) => t.id === id)).filter(Boolean);
                      return (
                        <div class="le2__leaders le2__leaders--sub">
                          <span class="le2__faces">{ps.map((t) => t!.data.photo && <button type="button" class="le2__face" data-member={t!.id} aria-haspopup="dialog" title={`Read ${t!.data.name}'s bio`}><Img src={t!.data.photo} alt={t!.data.name} sizes="40px" /></button>)}</span>
                          <span><strong>{ps.map((t, i) => <>{i > 0 && ' & '}<button type="button" class="le2__name" data-member={t!.id} aria-haspopup="dialog">{t!.data.name}</button></>)}</strong><em>{c.partnersLabel ?? 'Managing Partners'}</em></span>
                        </div>
                      );
                    })()}
                  </div>
                  {c.cta && <a class="link-arrow" href={c.cta.url} target={ext ? '_blank' : undefined} rel="noopener">{c.cta.label} {ext ? '↗' : '→'}</a>}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <div class="le2__phases reveal">
        <p class="le2__label">{L.phasesHeading}</p>
        <ol>
          {L.phases.map((ph, i) => {
            const lead = ph.lch === 'lead' && ph.elevate === 'lead' ? 'both' : ph.lch === 'lead' ? 'lch' : 'elevate';
            // A shared phase turns its green half toward the neighbouring Elevate-led (construction) phase
            const leadOf = (q: any) => q && (q.lch === 'lead' && q.elevate === 'lead' ? 'both' : q.lch === 'lead' ? 'lch' : 'elevate');
            const greenLeft = lead === 'both' && leadOf(L.phases[i - 1]) === 'elevate';
            return (
              <li class:list={[`is-${lead}`, { 'is-both--green-left': greenLeft }]}>
                <span class="le2__num">{String(i + 1).padStart(2, '0')}</span>
                <strong>{ph.title}</strong>
                <span class="le2__who">{lead === 'both' ? 'LCH + Elevate' : lead === 'lch' ? 'LCH leads' : 'Elevate leads'}</span>
                <span class="le2__note">{ph.note}</span>
              </li>
            );
          })}
        </ol>
        <p class="le2__key"><span class="k k--lch"></span>LCH <span class="k k--el"></span>Elevate <span class="k k--both"></span>Together</p>
      </div>

    </div>
  </section>

  <section class="section acta">
    <div class="container acta__inner">
      <div>
        <h2>{story.cta.heading}</h2>
        <p class="lede">{story.cta.body}</p>
      </div>
      <div class="acta__btns">
        <a class="btn" href={story.cta.ctaUrl}>{story.cta.ctaLabel} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={story.cta.secondaryUrl}>{story.cta.secondaryLabel}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Team filter: All / LCH Developments / Elevate
  const tchips = document.querySelectorAll<HTMLButtonElement>('[data-team-filter]');
  tchips.forEach((chip) => chip.addEventListener('click', () => {
    const f = chip.dataset.teamFilter!;
    tchips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    document.querySelectorAll<HTMLElement>('.member[data-companies]').forEach((m) => {
      m.hidden = f !== 'all' && !(m.dataset.companies ?? '').split(' ').includes(f);
    });
  }));

  document.querySelectorAll<HTMLElement>('[data-tl]').forEach((tl) => {
    const track = tl.querySelector<HTMLElement>('[data-tl-track]')!;
    const prev = tl.querySelector<HTMLButtonElement>('[data-tl-prev]')!;
    const next = tl.querySelector<HTMLButtonElement>('[data-tl-next]')!;
    const step = () => (track.querySelector<HTMLElement>('.tl__card')?.offsetWidth ?? 300) + 20;
    const update = () => {
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();

    // On first view, slide from the beginning to the most recent chapter; visitors can then click or swipe back.
    let raf = 0, cancelled = false;
    const stop = () => { cancelled = true; cancelAnimationFrame(raf); track.classList.remove('is-sliding'); };
    ['pointerdown', 'wheel', 'touchstart', 'keydown'].forEach((ev) => track.addEventListener(ev, stop, { passive: true }));
    prev.addEventListener('click', stop);
    next.addEventListener('click', stop);
    const slideToEnd = () => {
      const end = track.scrollWidth - track.clientWidth;
      if (end <= 0 || cancelled) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { track.scrollLeft = end; return; }
      track.classList.add('is-sliding');
      const t0 = performance.now(), dur = Math.min(2600, 700 + end * 0.9);
      const tick = (now: number) => {
        if (cancelled) return;
        const t = Math.min(1, (now - t0) / dur);
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; // ease in-out
        track.scrollLeft = end * e;
        if (t < 1) raf = requestAnimationFrame(tick);
        else track.classList.remove('is-sliding');
      };
      raf = requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(slideToEnd, 350); }
    }, { threshold: 0.45 });
    io.observe(track);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-member]').forEach((b) => {
    const dlg = document.getElementById(`bio-${b.dataset.member}`) as HTMLDialogElement;
    b.addEventListener('click', () => dlg.showModal());
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>

<style>
  .le2__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 5vw, 80px); align-items: end; margin-bottom: clamp(32px, 4vw, 52px); }
  .le2__head h2 { margin: 0; }
  .le2__intro { margin: 0; font-size: 18px; color: rgba(246, 244, 239, 0.75); }
  .le2__cos { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 28px); }
  .le2__co { background: #1f1f1c; border: 1px solid rgba(246, 244, 239, 0.12); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
  .le2__co--elevate { background: #16332a; border-color: rgba(160, 210, 180, 0.18); }
  .le2__img { position: relative; }
  .le2__img > :global(img) { width: 100%; aspect-ratio: 16 / 8; object-fit: cover; display: block; }
  .le2__badge { position: absolute; left: 20px; bottom: -26px; width: max-content; background: #fff; padding: 10px 16px; border-radius: 2px; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
  .le2__badge img { height: 34px; width: auto; max-width: none; display: block; }
  .le2__cobody { padding: 44px 28px 26px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
  .le2__cobody h3 { font-size: 26px; margin: 0; color: #fff; }
  .le2__tag { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(246, 244, 239, 0.55); }
  .le2__desc { margin: 0; color: rgba(246, 244, 239, 0.78); }
  .le2__cobody ul { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 18px; font-size: 15px; color: rgba(246, 244, 239, 0.9); }
  .le2__cobody li { padding-left: 16px; position: relative; }
  .le2__cobody li::before { content: ''; position: absolute; left: 0; top: 9px; width: 6px; height: 6px; background: currentColor; opacity: .55; }
  .le2__values { display: flex; gap: 8px; flex-wrap: wrap; margin: -2px 0 4px; }
  .le2__values span { font-size: 13px; font-weight: 600; padding: 4px 10px; background: rgba(246, 244, 239, 0.1); color: #f1ede4; border-radius: 2px; }
  .le2__co--elevate .le2__values span { background: rgba(160, 210, 180, 0.16); color: #cfe6d7; }
  .le2__foot { margin-top: auto; padding-top: 18px; border-top: 1px solid rgba(246, 244, 239, 0.14); display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .le2__leaders { display: flex; align-items: center; gap: 12px; }
  .le2__faces { display: flex; }
  .le2__faces :global(img) { display: block; width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(246, 244, 239, 0.9); }
  .le2__face { all: unset; cursor: pointer; display: block; border-radius: 50%; transition: transform .2s; }
  .le2__face + .le2__face { margin-left: -10px; }
  .le2__face:hover, .le2__face:focus-visible { transform: translateY(-2px); position: relative; z-index: 1; }
  .le2__name { all: unset; cursor: pointer; text-decoration: underline; text-decoration-color: rgba(246,244,239,.35); text-underline-offset: 3px; }
  .le2__name:hover, .le2__name:focus-visible { text-decoration-color: #fff; }
  .le2__leaders strong { display: block; font-size: 14.5px; color: #fff; }
  .le2__leaders em { font-style: normal; font-size: 13px; color: rgba(246, 244, 239, 0.6); }
  .le2 .link-arrow { color: #fff; }
  .le2__label { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(246, 244, 239, 0.55); margin: 0 0 14px; }
  .le2__phases { margin-top: clamp(36px, 4.5vw, 56px); }
  .le2__phases ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; }
  .le2__phases li { padding: 18px 16px 20px; display: grid; gap: 4px; align-content: start; min-height: 150px; }
  .le2__phases li.is-lch { background: #3a3a35; color: #fff; }
  .le2__phases li.is-elevate { background: #3f8a63; color: #fff; }
  .le2__phases li.is-both { background: linear-gradient(135deg, #3a3a35 0 50%, #3f8a63 50% 100%); color: #fff; }
  .le2__phases li.is-both--green-left { background: linear-gradient(135deg, #3f8a63 0 50%, #3a3a35 50% 100%); }
  .le2__num { font-size: 12px; opacity: .6; font-variant-numeric: tabular-nums; }
  .le2__phases strong { font-size: 17px; }
  .le2__who { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: .85; }
  .le2__note { font-size: 14px; opacity: .85; margin-top: 6px; }
  .le2__key { display: flex; align-items: center; gap: 8px 14px; flex-wrap: wrap; margin: 12px 0 0; font-size: 13px; color: rgba(246, 244, 239, 0.65); }
  .le2__key .k { width: 14px; height: 14px; display: inline-block; margin-right: -6px; }
  .k--lch { background: #3a3a35; box-shadow: 0 0 0 1px rgba(246,244,239,.3); } .k--el { background: #3f8a63; } .k--both { background: linear-gradient(135deg, #3a3a35 0 50%, #3f8a63 50% 100%); }
  @media (max-width: 900px) { .le2__phases ol { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .le2__phases ol { grid-template-columns: 1fr; } .le2__phases li { min-height: 0; } }
  .le2__matrix { margin-top: clamp(36px, 4.5vw, 56px); }
  .le2__grid { display: grid; gap: 4px; }
  .le2__row { display: grid; grid-template-columns: 110px repeat(5, 1fr); gap: 4px; align-items: stretch; }
  .le2__row--head span { font-size: 15px; font-weight: 700; color: #fff; padding: 0 4px 6px; }
  .le2__row--head em { display: block; font-style: normal; font-size: 12px; font-weight: 500; color: rgba(246, 244, 239, 0.45); }
  .le2__rowname { display: flex; align-items: center; font-weight: 700; font-size: 14px; color: #fff; }
  .le2__cell { padding: 12px 14px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 2px; }
  .le2__row--lch .is-lead { background: #f6f4ef; color: var(--ink); }
  .le2__row--elevate .is-lead { background: #3f8a63; color: #fff; }
  .le2__cell.is-support { background: transparent; color: rgba(246, 244, 239, 0.6); border: 1px dashed rgba(246, 244, 239, 0.3); }
  .le2__row--notes span { font-size: 13.5px; color: rgba(246, 244, 239, 0.65); padding: 8px 4px 0; }
  .le2__together { margin-top: clamp(36px, 4.5vw, 56px); }
  .le2__projects { display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(10px, 1.4vw, 16px); }
  .le2__proj { color: #fff; text-decoration: none; display: grid; gap: 10px; }
  .le2__proj :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; border-radius: 2px; transition: transform .4s ease, opacity .3s; }
  .le2__proj:hover :global(img) { opacity: .85; }
  .le2__proj span { font-weight: 700; font-size: 15px; display: flex; flex-direction: column; border-left: 3px solid var(--dot); padding-left: 10px; }
  .le2__proj em { font-style: normal; font-weight: 500; font-size: 13px; color: rgba(246, 244, 239, 0.6); }

  /* compact: whole section fits one screen */
  .le2.section { padding-block: clamp(36px, 4vw, 56px); scroll-margin-top: var(--header-h, 72px); }
  .le2__head { margin-bottom: clamp(18px, 2vw, 28px); }
  .le2__head h2 { font-size: clamp(28px, 3vw, 42px); }
  .le2__intro { font-size: 16px; }
  .le2__co { flex-direction: row; }
  .le2__img { flex: 0 0 34%; }
  .le2__img > :global(img) { height: 100%; aspect-ratio: auto; min-height: 220px; }
  .le2__badge { left: 14px; bottom: 14px; padding: 7px 10px; }
  .le2__badge img { height: 24px; }
  .le2__cobody { padding: 20px 22px; gap: 8px; }
  .le2__cobody h3 { font-size: 20px; }
  .le2__tag { font-size: 11px !important; }
  .le2__desc { font-size: 14px; line-height: 1.45; }
  .le2__foot { padding-top: 12px; }
  .le2__faces :global(img) { width: 36px; height: 36px; }
  .le2__phases { margin-top: clamp(20px, 2.4vw, 32px); }
  .le2__phases li { min-height: 0; padding: 10px 14px 12px; }
  .le2__phases strong { font-size: 15.5px; }
  .le2__note { font-size: 13px; margin-top: 2px; }
  .le2__label { margin-bottom: 10px; }
  @media (max-width: 900px) { .le2__co { flex-direction: column; } .le2__img > :global(img) { aspect-ratio: 16 / 8; min-height: 0; } }
