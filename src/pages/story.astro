---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import { render } from 'astro:content';
import { story, getTeam, md } from '../lib/site';

const team = await Promise.all((await getTeam()).map(async (t) => ({ ...t, Content: (await render(t)).Content })));
---

<Base overlay title="Our Story" description="Founded in 2007 by brothers Michal and Lukasz Wywrot, LCH Developments creates homes, workspaces and communities across the Greater Toronto Area." image={story.hero.image}>
  <PageHero eyebrow={story.hero.eyebrow} heading={story.hero.heading} image={story.hero.image} />

  <section class="section">
    <div class="container intro">
      <h2 class="reveal">{story.intro.heading}</h2>
      <p class="lede reveal">{story.intro.body}</p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <p class="eyebrow">Our values</p>
      <div class="values">
        {story.values.map((v, i) => (
          <article class="value reveal">
            <p class="value__num">0{i + 1}</p>
            <h3 class="value__title display">{v.title}</h3>
            <p>{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container history">
      <div class="history__media reveal">
        <Img src={story.history.image} alt="Michal and Lukasz Wywrot" sizes="(max-width: 900px) 100vw, 40vw" />
        {story.timeline?.length > 0 && (
          <ol class="timeline">
            {story.timeline.map((t) => <li><span class="display">{t.year}</span><p>{t.text}</p></li>)}
          </ol>
        )}
      </div>
      <div class="history__text">
        <p class="eyebrow">{story.history.eyebrow}</p>
        <h2>{story.history.heading}</h2>
        <div class="prose" set:html={md(story.history.body)} />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container"><div class="elevate reveal">
      <p class="eyebrow">Elevate Construction Management</p>
      <h2>{story.elevate.heading}</h2>
      <p class="lede">{story.elevate.body}</p>
    </div></div>
  </section>

  <section class="section" id="team">
    <div class="container">
      <p class="eyebrow">{story.team.eyebrow}</p>
      <h2 class="team-h">{story.team.heading}</h2>
      <div class="team">
        {team.map((t) => (
          <article class="member reveal">
            <button class="member__btn" data-member={t.id} aria-haspopup="dialog">
              <div class="member__photo">
                {t.data.photo && <Img src={t.data.photo} alt={t.data.name} sizes="(max-width: 600px) 50vw, 25vw" />}
              </div>
              <h3>{t.data.name}{t.data.credentials && <span class="member__cred">, {t.data.credentials}</span>}</h3>
              <p class="member__role">{t.data.role}</p>
              <span class="member__more">Read bio +</span>
            </button>
            <dialog class="bio" id={`bio-${t.id}`} aria-label={`${t.data.name} biography`}>
              <button class="bio__close" data-close aria-label="Close">×</button>
              <div class="bio__grid">
                {t.data.photo && <Img src={t.data.photo} alt={t.data.name} sizes="300px" class="bio__photo" />}
                <div>
                  <p class="eyebrow">{t.data.role}</p>
                  <h2>{t.data.name}</h2>
                  {t.data.credentials && <p class="member__cred">{t.data.credentials}</p>}
                  <div class="prose"><t.Content /></div>
                </div>
              </div>
            </dialog>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-member]').forEach((b) => {
    const dlg = document.getElementById(`bio-${b.dataset.member}`) as HTMLDialogElement;
    b.addEventListener('click', () => dlg.showModal());
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>

<style>
  .intro { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .intro .lede { font-size: clamp(18px, 1.5vw, 20px); color: var(--ink-2); }

  .values { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(32px, 4vw, 64px); }
  .value { border-top: 1px solid rgba(246, 244, 239, 0.2); padding-top: 28px; }
  .value__num { font-size: 13px; letter-spacing: 0.12em; color: var(--accent); font-weight: 600; }
  .value__title { font-size: clamp(36px, 3.4vw, 52px); margin-bottom: 20px; }
  .value p:last-child { color: rgba(246, 244, 239, 0.72); font-size: 16px; }

  .history { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 7vw, 112px); align-items: start; }
  .history__media { position: sticky; top: calc(var(--header-h) + 24px); }
  .history__media :global(img) { border-radius: var(--radius); width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .history h2 { margin-bottom: 32px; }
  .history .prose { font-size: 18px; }
  .timeline { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 0; }
  .timeline li { display: grid; grid-template-columns: 90px 1fr; gap: 16px; padding: 16px 0; border-top: 1px solid var(--line); }
  .timeline span { font-size: 26px; line-height: 1; color: var(--accent); }
  .timeline p { margin: 0; font-size: 15px; color: var(--muted); }

  .elevate { max-width: 900px; }
  .elevate h2 { margin-bottom: 24px; }

  .team-h { margin-bottom: 48px; }
  .team { display: grid; grid-template-columns: repeat(4, 1fr); gap: 48px 28px; }
  .member__btn { all: unset; cursor: pointer; display: block; width: 100%; }
  .member__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .member__photo { aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius); background: var(--paper-2); margin-bottom: 18px; }
  .member__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; filter: grayscale(1); transition: filter 0.5s, transform 1s var(--ease); }
  .member__btn:hover .member__photo :global(img) { filter: grayscale(0); transform: scale(1.03); }
  .member h3 { font-size: 19px; }
  .member__cred { color: var(--muted); font-weight: 400; font-size: 0.85em; }
  .member__role { font-size: 15px; color: var(--muted); margin: 4px 0 10px; }
  .member__more { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }

  .bio { width: min(960px, calc(100vw - 32px)); max-height: calc(100dvh - 48px); border: 0; border-radius: 8px; padding: clamp(24px, 4vw, 56px); background: var(--paper); color: var(--ink); }
  .bio::backdrop { background: rgba(10, 10, 9, 0.6); backdrop-filter: blur(4px); }
  .bio__grid { display: grid; grid-template-columns: 260px 1fr; gap: 40px; align-items: start; }
  .bio__grid :global(.bio__photo) { border-radius: var(--radius); width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .bio h2 { font-size: clamp(36px, 4vw, 52px); margin-bottom: 8px; }
  .bio .eyebrow { margin-bottom: 12px; }
  .bio .prose { margin-top: 20px; font-size: 16px; }
  .bio__close { position: absolute; top: 12px; right: 16px; border: 0; background: none; font-size: 36px; cursor: pointer; color: var(--ink); line-height: 1; }

  @media (max-width: 1000px) { .team { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px) {
    .intro, .history, .values { grid-template-columns: 1fr; }
    .history__media { position: static; }
  }
  @media (max-width: 680px) {
    .team { grid-template-columns: repeat(2, 1fr); gap: 36px 16px; }
    .bio__grid { grid-template-columns: 1fr; }
    .bio__grid :global(.bio__photo) { max-width: 200px; }
  }
</style>
